/* ════════════════════════════════════════════════════════════════════
   NURU V12 — Thème DM-1 "Dawn Cyan" (Light)
   Design system clair, élégant — palette #0099BB cyan
   Palette : #F0F4F8 fond, #0099BB accent, arrondis 8px
═══════════════════════════════════════════════════════════════ */

/* ── Base ─────────────────────────────────────────────────────── */

QMainWindow {
    background-color: #FFFFFF;
}
QWidget {
    background-color: transparent;
    color: #1A2332;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
}

/* ── SIDEBAR ──────────────────────────────────────────────────── */

#Sidebar {
    background-color: #F0F4F8;
    border-right: 1px solid #D1D9E6;
    min-width: 60px;
    max-width: 220px;
}
#SidebarHeader {
    background-color: #F0F4F8;
    border-bottom: 1px solid #D1D9E6;
    padding: 18px 14px 14px;
}
#LogoLabel {
    font-size: 18px;
    font-weight: 700;
    color: #1A2332;
    letter-spacing: -0.02em;
}
#VersionBadge {
    background-color: #E0F0F8;
    color: #0099BB;
    border: 1px solid rgba(0, 153, 187, 0.2);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#NavSectionLabel {
    color: #6B7A90;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 14px 14px 6px;
}
#NavButton {
    background-color: transparent;
    color: #6B7A90;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    text-align: left;
    font-size: 13px;
    font-weight: 400;
    margin: 1px 8px;
    letter-spacing: 0.01em;
}
#NavButton:hover {
    background-color: #EAEAF0;
    color: #5A5A6E;
}
#NavButton[active="true"] {
    background-color: rgba(0, 153, 187, 0.08);
    color: #0099BB;
    font-weight: 500;
}
#CollapseSidebarBtn {
    background-color: transparent;
    color: #6B7A90;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    padding: 0;
}
#CollapseSidebarBtn:hover {
    background-color: #E8E8F0;
    color: #5A5A6E;
}

/* NavSectionToggle */
#NavSectionToggle {
    background-color: transparent;
    color: #6B7A90;
    border: 1px dashed #D0D0D8;
    border-radius: 6px;
    padding: 6px 14px;
    text-align: left;
    font-size: 11px;
    font-weight: 500;
    margin: 6px 8px 2px;
    letter-spacing: 0.04em;
}
#NavSectionToggle:hover {
    background-color: #EAEAF0;
    color: #6B7A90;
    border-color: #B0B0C0;
}
#NavSectionToggle:checked {
    background-color: rgba(0, 153, 187, 0.06);
    color: #0099BB;
    border-color: rgba(0, 153, 187, 0.2);
}

/* NavButton secondaire */
#NavButton[secondary="true"] {
    padding: 6px 14px 6px 24px;
    font-size: 12px;
    color: #6A6A7E;
}
#NavButton[secondary="true"]:hover {
    background-color: #EAEAF0;
    color: #9A9AB0;
}
#NavButton[secondary="true"][active="true"] {
    background-color: rgba(0, 153, 187, 0.06);
    color: #0099BB;
}

/* Mini-mode */
#NavButton[mini="true"] {
    padding: 8px 4px;
    margin: 1px 4px;
    text-align: center;
    font-size: 16px;
}
#NavButton[mini="true"]:hover {
    background-color: #EAEAF0;
}
#NavButton[mini="true"][active="true"] {
    background-color: rgba(0, 153, 187, 0.08);
}

/* Recent Documents */
#RecentDocuments {
    background-color: transparent;
    margin: 2px 8px;
    padding: 6px 0;
}
#RecentDocumentsHeader {
    font-size: 11px;
    font-weight: 600;
    color: #8A8A9E;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 8px 6px 4px;
}
#RecentDocItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    color: #6A6A7E;
}
#RecentDocItem:hover {
    background-color: #EAEAF0;
    color: #6A6A7E;
}
#DocDot {
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
    border-radius: 2.5px;
}
#DocDot[indexed="true"] {
    background-color: #16A34A;
}
#DocDot[partial="true"] {
    background-color: #D97706;
}

/* CloudStatusBadge */
#CloudStatusBadge {
    background-color: #F0F4F8;
    border: 1px solid #D1D9E6;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 0 8px;
}
#CloudStatusDot {
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #16A34A;
}
#CloudStatusText {
    font-size: 10px;
    color: #16A34A;
    letter-spacing: 0.03em;
}

/* ModelInfoFooter */
#ModelInfoFooter {
    background-color: transparent;
    color: #6A6A7E;
    font-size: 11px;
    padding: 12px 14px;
    border-top: 1px solid #D1D9E6;
}

/* ── CHAT ZONE ────────────────────────────────────────────────────── */

#ChatZone {
    background-color: #FFFFFF;
}
#ChatHeader {
    background-color: #F0F4F8;
    border-bottom: 1px solid #D1D9E6;
    padding: 0 20px;
    min-height: 48px;
}
#ChatHeaderTitle {
    font-size: 14px;
    font-weight: 500;
    color: #6A6A7E;
}
#ChatHeader .QComboBox {
    background-color: #EAEAF0;
    color: #1A2332;
    border: 1px solid #D0D0D8;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    min-width: 120px;
}
#ChatHeader .QComboBox:hover {
    border-color: #B0B0C0;
}
#ChatHeader .QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}
#ChatHeader .QComboBox QAbstractItemView {
    background-color: #EAEAF0;
    color: #1A2332;
    border: 1px solid #D0D0D8;
    border-radius: 6px;
    selection-background-color: rgba(0, 153, 187, 0.15);
    selection-color: #0099BB;
}

/* ModeBadge */
#ModeBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#ModeBadge[mode="RAG"] {
    background-color: rgba(0, 153, 187, 0.12);
    color: #0099BB;
    border: 0.5px solid rgba(0, 153, 187, 0.2);
}
#ModeBadge[mode="LOCAL"] {
    background-color: rgba(22, 163, 74, 0.12);
    color: #16A34A;
    border: 0.5px solid rgba(22, 163, 74, 0.2);
}
#ModeBadge[mode="CLOUD"] {
    background-color: rgba(0, 153, 187, 0.12);
    color: #0099BB;
    border: 0.5px solid rgba(0, 153, 187, 0.2);
}
#ModeBadge[mode="VERIFY"] {
    background-color: rgba(217, 119, 0, 0.12);
    color: #D97706;
    border: 0.5px solid rgba(217, 119, 0, 0.2);
}
#ModeBadge[mode="PLAN"] {
    background-color: rgba(0, 153, 187, 0.12);
    color: #0099BB;
    border: 0.5px solid rgba(0, 153, 187, 0.2);
}

/* ConfidenceWidget */
#ConfidenceWidget {
    background-color: transparent;
    padding: 0;
}
#ConfidenceLabel {
    font-size: 11px;
    color: #6A6A7E;
    margin-right: 6px;
}
#ConfidenceBar {
    background-color: #D1D9E6;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
    min-width: 60px;
}
#ConfidenceBar::chunk {
    border-radius: 2px;
}
#ConfidenceBar[level="high"]::chunk {
    background-color: #16A34A;
}
#ConfidenceBar[level="mid"]::chunk {
    background-color: #D97706;
}
#ConfidenceBar[level="low"]::chunk {
    background-color: #DC2626;
}
#ConfidenceValue {
    font-size: 11px;
    font-weight: 500;
    min-width: 30px;
}
#ConfidenceValue[level="high"] {
    color: #16A34A;
}
#ConfidenceValue[level="mid"] {
    color: #D97706;
}
#ConfidenceValue[level="low"] {
    color: #DC2626;
}

/* Messages Area */
#MessagesArea {
    background-color: #FFFFFF;
    border: none;
}
#MessagesArea > QWidget {
    background-color: #FFFFFF;
}
#ChatContent {
    max-width: 720px;
    margin: 0px auto;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #D1D9E6;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #B0B0C0;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── BULLES DE CHAT ───────────────────────────────────────────── */

#BubbleNuru {
    background-color: #F0F4F8;
    border: 1px solid #D1D9E6;
    border-radius: 4px 12px 12px 12px;
    padding: 10px 14px;
}
#BubbleUser {
    background-color: rgba(0, 153, 187, 0.08);
    border: 1px solid rgba(0, 153, 187, 0.20);
    border-radius: 12px 4px 12px 12px;
    padding: 10px 14px;
}
#BubbleText {
    color: #3A3A4E;
    font-size: 13px;
    line-height: 1.55;
    background: transparent;
}
#BubbleText[role="user"] {
    color: #5A5A6E;
}
#MessageRow {
    padding: 6px 0;
}

/* ── FOOTER BULLE ────────────────────────────────────────────── */

#BubbleFooter {
    background: transparent;
    padding: 6px 0 2px;
}
#BubbleFooterLabel {
    font-size: 10px;
    color: #6A6A7E;
    letter-spacing: 0.02em;
}
#BubbleFooter QPushButton {
    background-color: transparent;
    border: none;
    color: #6A6A7E;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 3px;
}
#BubbleFooter QPushButton:hover {
    background-color: #EAEAF0;
    color: #5A5A6E;
}

/* ── INPUT AREA ───────────────────────────────────────────────── */

#InputFrameV7 {
    background-color: #F0F4F8;
    border: 1px solid #D0D0D8;
    border-radius: 10px;
    padding: 8px 12px;
    margin: 12px 20px;
    min-height: 40px;
}
#InputFrameV7:focus-within {
    border-color: rgba(0, 153, 187, 0.4);
}
#InputFrameV7 QPlainTextEdit {
    background-color: transparent;
    color: #3A3A4E;
    border: none;
    font-size: 13px;
    padding: 4px;
    selection-background-color: rgba(0, 153, 187, 0.3);
}
#SendButtonV7 {
    background-color: rgba(0, 153, 187, 0.10);
    color: #0099BB;
    border: 1px solid rgba(0, 153, 187, 0.15);
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
}
#SendButtonV7:hover {
    background-color: rgba(0, 153, 187, 0.20);
    border-color: rgba(0, 153, 187, 0.3);
}
#SendButtonV7:pressed {
    background-color: rgba(0, 153, 187, 0.3);
}
#InputArea QPushButton {
    background-color: transparent;
    color: #6A6A7E;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}
#InputArea QPushButton:hover {
    background-color: #EAEAF0;
    color: #5A5A6E;
}
#InputArea QPushButton[checked="true"] {
    color: #0099BB;
    background-color: rgba(0, 153, 187, 0.08);
}

/* ── NOTIFICATIONS / POPUPS ──────────────────────────────────────────── */

#NotificationWidget {
    background-color: #EAEAF0;
    border: 1px solid #D0D0D8;
    border-radius: 10px;
    padding: 12px 16px;
}
#NotificationWidget QLabel {
    font-size: 11px;
    color: #3A3A4E;
}

/* ── CONVERSATION LIST ─────────────────────────────────────────── */

#ConversationList {
    background-color: transparent;
    padding: 0;
    margin: 0 4px;
}
#ConversationListHeader {
    font-size: 11px;
    font-weight: 600;
    color: #6A6A7E;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 10px 10px 4px;
}
#ConversationItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 1px 4px;
}
#ConversationItem:hover {
    background-color: #EAEAF0;
}
#ConversationItem QLabel#ConvTitle {
    font-size: 12px;
    font-weight: 500;
    color: #3A3A4E;
}
#ConversationItem QLabel#ConvDate {
    font-size: 10px;
    color: #6A6A7E;
}
#NewConversationBtn {
    background-color: rgba(0, 153, 187, 0.08);
    color: #0099BB;
    border: 1px solid rgba(0, 153, 187, 0.12);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 500;
    margin: 4px 8px;
    text-align: center;
}
#NewConversationBtn:hover {
    background-color: rgba(0, 153, 187, 0.15);
}

/* ── RIGHT PANEL / METRICS ────────────────────────────────────── */

#RightPanel {
    background-color: #F0F4F8;
    border-left: 1px solid #D1D9E6;
    min-width: 260px;
    max-width: 300px;
}
#RightPanelHeader {
    font-size: 12px;
    font-weight: 600;
    color: #6A6A7E;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 16px 14px 8px;
}
#RightPanel QLabel#MetricLabel {
    color: #6A6A7E;
    font-size: 11px;
}
#RightPanel QLabel#MetricValue {
    color: #1A2332;
    font-size: 14px;
    font-weight: 600;
}
#RightPanel QLabel#MetricSubtitle {
    color: #6A6A7E;
    font-size: 10px;
}

/* ── PLACEHOLDER PAGES ────────────────────────────────────────── */

#PlaceholderPageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #1A2332;
    margin-bottom: 8px;
}
#PlaceholderPageDesc {
    font-size: 13px;
    color: #6A6A7E;
    line-height: 1.5;
}

/* ── TABS ─────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: #FFFFFF;
    border: none;
    border-top: 1px solid #D1D9E6;
}
QTabBar::tab {
    background-color: transparent;
    color: #6A6A7E;
    border: none;
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #5A5A6E;
}
QTabBar::tab:selected {
    color: #0099BB;
    border-bottom: 2px solid #0099BB;
}

/* ── PROGRESS BAR ─────────────────────────────────────────────── */

QProgressBar {
    background-color: #D1D9E6;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #0099BB;
    border-radius: 3px;
}
QProgressBar::chunk[status="success"]::chunk {
    background-color: #16A34A;
}

/* ── TOOLTIP ──────────────────────────────────────────────────── */

QToolTip {
    background-color: #EAEAF0;
    color: #1A2332;
    border: 1px solid #D0D0D8;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ── RELOAD BADGE ─────────────────────────────────────────────── */

#ReloadBadge {
    background-color: rgba(217, 119, 0, 0.1);
    color: #D97706;
    border: 1px solid rgba(217, 119, 0, 0.15);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 500;
    margin: 4px 8px;
}

/* ── STAT CARD ────────────────────────────────────────────────── */

#StatCard {
    background-color: #F0F4F8;
    border: 1px solid #D1D9E6;
    border-radius: 10px;
    padding: 12px;
}
#StatCardTitle {
    font-size: 10px;
    font-weight: 500;
    color: #6A6A7E;
    letter-spacing: 0.02em;
}
#StatCardValue {
    font-size: 22px;
    font-weight: 700;
    color: #1A2332;
}
#StatCardIcon {
    font-size: 18px;
}

/* MiniStatCard */
#MiniStatCard {
    background-color: #F0F4F8;
    border: 1px solid #D1D9E6;
    border-radius: 8px;
    padding: 8px;
}
#MiniStatCardLabel {
    font-size: 10px;
    font-weight: 500;
    color: #6A6A7E;
}
#MiniStatCardValue {
    font-size: 16px;
    font-weight: 700;
    color: #1A2332;
}
#MiniStatCardSubtitle {
    font-size: 10px;
    color: #6A6A7E;
}

/* ── THEME TOGGLE ─────────────────────────────────────────────── */

#ThemeToggleBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    padding: 2px;
}
#ThemeToggleBtn:hover {
    background-color: rgba(0, 153, 187, 0.1);
}
#ThemeLabel {
    font-size: 10px;
    color: #6A6A7E;
}
#ThemeRow {
    background-color: transparent;
    border-top: 1px solid #D1D9E6;
}
