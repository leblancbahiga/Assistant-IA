/* ═══════════════════════════════════════════════════════════════════
   NURU V15 — Thème "NEON COGNITIVE"
   Design System verre morphique + néon cybernétique
   Palette : #05080F fond, #00F0FF cyan, #7C3AED violet, glass rgba
═══════════════════════════════════════════════════════════════════ */

/* ── Base ───────────────────────────────────────────────────────── */

QMainWindow { background-color: #05080F; }

QWidget {
    background-color: transparent;
    color: #E8F0FF;
    font-family: "SF Pro Display", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13pt;
}

/* ── Glass Panel (réutilisable) ────────────────────────────────── */

GlassPanel, QFrame#GlassPanel {
    background: rgba(12, 20, 40, 0.72);
    border: 1px solid rgba(0, 240, 255, 0.08);
    border-radius: 14px;
}

/* ── SIDEBAR ──────────────────────────────────────────────────── */

#Sidebar {
    background: rgba(10, 16, 30, 0.85);
    border-right: 1px solid rgba(0, 240, 255, 0.08);
    min-width: 52px;
    max-width: 200px;
}

#SidebarHeader {
    background: transparent;
    border-bottom: 1px solid rgba(0, 240, 255, 0.08);
    padding: 20px 16px 16px;
}

#LogoLabel {
    font-size: 17pt;
    font-weight: 700;
    color: #E8F0FF;
    letter-spacing: -0.02em;
}
#LogoLabel #CyanAccent {
    color: #00F0FF;
}
#LogoLabel #VioletAccent {
    color: #7C3AED;
}

#VersionBadge {
    background: rgba(0, 240, 255, 0.06);
    color: #00F0FF;
    border: 1px solid rgba(0, 240, 255, 0.18);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10pt;
    font-weight: 500;
    letter-spacing: 0.06em;
}

#NavSectionLabel {
    color: rgba(139, 160, 200, 0.45);
    font-size: 10pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 16px 14px 6px;
}

#NavButton {
    background: transparent;
    color: rgba(139, 160, 200, 0.7);
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    text-align: left;
    font-size: 13pt;
    font-weight: 400;
    margin: 1px 8px;
    letter-spacing: 0.01em;
}
#NavButton:hover {
    background: rgba(0, 240, 255, 0.08);
    color: #E8F0FF;
}
#NavButton[active="true"] {
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.20);
    color: #00F0FF;
    font-weight: 500;
}

#CollapseSidebarBtn {
    background: transparent;
    color: rgba(139, 160, 200, 0.4);
    border: none;
    border-radius: 6px;
    font-size: 11pt;
    padding: 0;
}
#CollapseSidebarBtn:hover {
    background: rgba(0, 240, 255, 0.08);
    color: #E8F0FF;
}

/* NavButton secondaire */
#NavButton[secondary="true"] {
    padding: 5px 14px 5px 24px;
    font-size: 11pt;
    color: rgba(139, 160, 200, 0.55);
}
#NavButton[secondary="true"]:hover {
    background: rgba(0, 240, 255, 0.06);
    color: #E8F0FF;
}
#NavButton[secondary="true"][active="true"] {
    background: rgba(0, 240, 255, 0.08);
    color: #00F0FF;
}

/* Mini-mode sidebar */
#NavButton[mini="true"] {
    padding: 8px 4px;
    margin: 1px 4px;
    text-align: center;
    font-size: 15pt;
}

/* ── Recent Documents ──────────────────────────────────────────── */

#RecentDocuments {
    background: transparent;
    margin: 2px 8px;
    padding: 6px 0;
}
#RecentDocumentsHeader {
    font-size: 10pt;
    font-weight: 600;
    color: rgba(139, 160, 200, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 10px 6px 4px;
}
#RecentDocItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 11pt;
    color: rgba(139, 160, 200, 0.6);
}
#RecentDocItem:hover {
    background: rgba(0, 240, 255, 0.06);
    color: #E8F0FF;
}
#DocDot {
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
    border-radius: 2.5px;
}
#DocDot[indexed="true"] { background-color: #00FFAA; }
#DocDot[partial="true"] { background-color: #FFB800; }

/* ── CloudStatusBadge ──────────────────────────────────────────── */

#CloudStatusBadge {
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.10);
    border-radius: 10px;
    padding: 8px 12px;
    margin: 0 8px;
}
#CloudStatusDot {
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #00FFAA;
}
#CloudStatusText {
    font-size: 10pt;
    color: rgba(139, 160, 200, 0.7);
    letter-spacing: 0.02em;
}

/* ── NuruWindow — fenêtre principale ─────────────────────────── */

#NuruWindow {
    background: #05080F;
    border-radius: 0px;
}

#TitleBar {
    background: transparent;
    padding: 8px 16px 4px;
    border-bottom: 1px solid rgba(0, 240, 255, 0.06);
    min-height: 44px;
}

#TitleLabel {
    font-size: 11pt;
    font-weight: 400;
    color: rgba(139, 160, 200, 0.6);
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

#TitleStatusDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
}

/* ── Input Bar — barre de saisie ──────────────────────────────── */

#InputBar {
    background: transparent;
    border-top: 1px solid rgba(0, 240, 255, 0.06);
    padding: 12px 16px;
}

QLineEdit {
    background: rgba(12, 20, 40, 0.6);
    color: #E8F0FF;
    border: 1px solid rgba(0, 240, 255, 0.10);
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 13pt;
    font-family: "SF Pro Display", "Inter", sans-serif;
    selection-background-color: rgba(0, 240, 255, 0.25);
}
QLineEdit:focus {
    border-color: rgba(0, 240, 255, 0.45);
    background: rgba(12, 20, 40, 0.75);
}
QLineEdit:hover:not(:focus) {
    border-color: rgba(0, 240, 255, 0.16);
}
QLineEdit::placeholder {
    color: rgba(139, 160, 200, 0.3);
}

/* ── Buttons ──────────────────────────────────────────────────── */

QPushButton {
    background: rgba(12, 20, 40, 0.6);
    color: #E8F0FF;
    border: 1px solid rgba(0, 240, 255, 0.10);
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 12pt;
    font-weight: 500;
}
QPushButton:hover {
    background: rgba(0, 240, 255, 0.12);
    border-color: rgba(0, 240, 255, 0.25);
}
QPushButton:pressed {
    background: rgba(0, 240, 255, 0.18);
}
QPushButton#MicButton {
    background: rgba(12, 20, 40, 0.6);
    border: 1px solid rgba(0, 240, 255, 0.10);
    border-radius: 20px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    font-size: 16pt;
    padding: 0;
}
QPushButton#MicButton:hover {
    background: rgba(0, 240, 255, 0.12);
    border-color: rgba(0, 240, 255, 0.25);
}
QPushButton#MicButton[active="true"] {
    background: rgba(0, 255, 170, 0.15);
    border-color: rgba(0, 255, 170, 0.35);
}

/* ── Send Button ──────────────────────────────────────────────── */

QPushButton#SendButton {
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.20);
    border-radius: 20px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    font-size: 16pt;
    padding: 0;
}
QPushButton#SendButton:hover {
    background: rgba(0, 240, 255, 0.22);
    border-color: rgba(0, 240, 255, 0.35);
}

/* ── Chat Bubbles ─────────────────────────────────────────────── */

#UserBubble {
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 14px 14px 4px 14px;
    padding: 12px 16px;
    margin: 4px 60px 4px 16px;
    color: #E8F0FF;
}
#UserBubble:hover {
    border-color: rgba(0, 240, 255, 0.20);
}

#AssistantBubble {
    background: rgba(18, 28, 52, 0.65);
    border: 1px solid rgba(124, 58, 237, 0.12);
    border-radius: 14px 14px 14px 4px;
    padding: 12px 16px;
    margin: 4px 16px 4px 60px;
    color: #E8F0FF;
}
#AssistantBubble:hover {
    border-color: rgba(124, 58, 237, 0.20);
}

/* ── Typing Indicator ─────────────────────────────────────────── */

#TypingIndicator {
    background: transparent;
    padding: 8px 60px 8px 16px;
}
#TypingDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background: rgba(124, 58, 237, 0.5);
}

/* ── Scrollbars ───────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background: rgba(0, 240, 255, 0.15);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(0, 240, 255, 0.25);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(0, 240, 255, 0.15);
    border-radius: 4px;
    min-width: 30px;
}

/* ── Floating Widget ──────────────────────────────────────────── */

#FloatingWidget {
    background: rgba(10, 16, 30, 0.88);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 16px;
}

#FloatingHeader {
    background: transparent;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(0, 240, 255, 0.06);
}

#FloatingStatus {
    font-size: 10pt;
    color: rgba(139, 160, 200, 0.6);
    letter-spacing: 0.04em;
}

#FloatingTranscript {
    font-size: 11pt;
    color: rgba(139, 160, 200, 0.7);
    padding: 8px 14px;
    font-weight: 300;
}

/* ── Command Palette ──────────────────────────────────────────── */

QFrame#CommandPalette {
    background: rgba(10, 16, 30, 0.92);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 16px;
}
QFrame#CommandPalette QLineEdit {
    background: rgba(12, 20, 40, 0.5);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13pt;
    margin: 12px;
}
QFrame#CommandPalette QListWidget {
    background: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 12pt;
    color: #E8F0FF;
}
QFrame#CommandPalette QListWidget::item {
    background: transparent;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 1px 4px;
}
QFrame#CommandPalette QListWidget::item:selected {
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.18);
    color: #00F0FF;
}
QFrame#CommandPalette QListWidget::item:hover:!selected {
    background: rgba(0, 240, 255, 0.05);
}

/* ── Overlay ──────────────────────────────────────────────────── */

#VoiceOverlay {
    background: rgba(5, 8, 15, 0.88);
    border: 1px solid rgba(0, 240, 255, 0.10);
    border-radius: 20px;
}

#OverlayPrompt {
    font-size: 20pt;
    font-weight: 300;
    color: rgba(139, 160, 200, 0.6);
    letter-spacing: 0.02em;
}

#OverlayTranscript {
    font-size: 24pt;
    font-weight: 200;
    color: #E8F0FF;
    letter-spacing: 0.01em;
}

/* ── Preferences Dialog ───────────────────────────────────────── */

QDialog#PreferencesDialog {
    background: rgba(10, 16, 30, 0.92);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 16px;
}
QDialog#PreferencesDialog QLabel {
    color: #E8F0FF;
}
QDialog#PreferencesDialog QGroupBox {
    border: 1px solid rgba(0, 240, 255, 0.08);
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 16px;
    color: #00F0FF;
    font-weight: 500;
}
QDialog#PreferencesDialog QComboBox {
    background: rgba(12, 20, 40, 0.6);
    border: 1px solid rgba(0, 240, 255, 0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #E8F0FF;
    min-height: 28px;
}
QDialog#PreferencesDialog QComboBox::drop-down {
    border: none;
    width: 24px;
}
QDialog#PreferencesDialog QComboBox:hover {
    border-color: rgba(0, 240, 255, 0.20);
}
QDialog#PreferencesDialog QCheckBox {
    spacing: 8px;
    color: #E8F0FF;
}
QDialog#PreferencesDialog QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid rgba(0, 240, 255, 0.20);
    border-radius: 4px;
    background: transparent;
}
QDialog#PreferencesDialog QCheckBox::indicator:checked {
    background: rgba(0, 240, 255, 0.25);
    border-color: rgba(0, 240, 255, 0.40);
}
QDialog#PreferencesDialog QSlider::groove:horizontal {
    height: 4px;
    background: rgba(0, 240, 255, 0.10);
    border-radius: 2px;
}
QDialog#PreferencesDialog QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background: #00F0FF;
    border-radius: 8px;
    margin: -6px 0;
}

/* ── Status indicators ───────────────────────────────────────── */

#StatusDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
}
#StatusDot[state="idle"] { background: #00FFAA; }
#StatusDot[state="thinking"] { background: #FFB800; }
#StatusDot[state="error"] { background: #FF3366; }
#StatusDot[state="sleep"] { background: rgba(139, 160, 200, 0.3); }

/* ── Tooltips ─────────────────────────────────────────────────── */

QToolTip {
    background: rgba(10, 16, 30, 0.95);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 8px;
    color: #E8F0FF;
    padding: 6px 10px;
    font-size: 11pt;
}

/* ── Menus ────────────────────────────────────────────────────── */

QMenu {
    background: rgba(10, 16, 30, 0.92);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 12px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 6px;
    color: #E8F0FF;
}
QMenu::item:selected {
    background: rgba(0, 240, 255, 0.10);
    color: #00F0FF;
}
QMenu::separator {
    height: 1px;
    background: rgba(0, 240, 255, 0.06);
    margin: 4px 8px;
}

/* ── Context Strip ────────────────────────────────────────────── */

#ContextStrip {
    background: rgba(124, 58, 237, 0.06);
    border: 1px solid rgba(124, 58, 237, 0.10);
    border-radius: 10px;
    padding: 6px 12px;
    margin: 4px 16px;
    min-height: 24px;
}
#ContextStripLabel {
    font-size: 10pt;
    color: #7C3AED;
    letter-spacing: 0.04em;
}
#ContextStripText {
    font-size: 10pt;
    color: rgba(139, 160, 200, 0.7);
}

/* ── Toast Notifications ──────────────────────────────────────── */

#ToastWidget {
    background: rgba(12, 20, 40, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 12px;
    padding: 10px 16px;
}
#ToastWidget[type="success"] {
    border-color: rgba(0, 255, 170, 0.20);
}
#ToastWidget[type="error"] {
    border-color: rgba(255, 51, 102, 0.20);
}
#ToastWidget[type="info"] {
    border-color: rgba(0, 240, 255, 0.15);
}

/* ── Markdown Renderer ────────────────────────────────────────── */

QLabel#MarkdownCode {
    background: rgba(5, 8, 15, 0.6);
    border: 1px solid rgba(0, 240, 255, 0.08);
    border-radius: 10px;
    padding: 10px 14px;
    font-family: "SF Mono", "JetBrains Mono", monospace;
    font-size: 11pt;
    color: #00F0FF;
}
