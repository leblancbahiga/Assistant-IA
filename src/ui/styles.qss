/* ═══════════════════════════════════════════════════════════════════
   NURU V8+ — Thème "Abyssal Flat"
   Palette : fonds sombres, flat design, zéro glow/neon
═══════════════════════════════════════════════════════════════════ */
QMainWindow { background-color: #0a0b0f; }
QWidget { background-color: transparent; color: #e8eaf0; font-family: "SF Pro Text", "Inter", sans-serif; font-size: 13px; }

/* ══════════════════════════════════════
   SIDEBAR (NavSidebar)
══════════════════════════════════════ */
#Sidebar { background-color: #111318; border-right: 1px solid #2e3347; min-width: 200px; max-width: 240px; }
#SidebarHeader { background-color: #111318; border-bottom: 1px solid #2e3347; padding: 12px 14px; }
#LogoLabel { font-size: 16px; font-weight: 600; color: #e8eaf0; }
#VersionBadge { background-color: #1e2540; color: #7f77dd; border: 1px solid rgba(127, 119, 221, 0.3); border-radius: 4px; padding: 1px 6px; font-size: 10px; font-weight: 600; }
#NavSectionLabel { color: #555e78; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; padding: 12px 16px 4px; }
#NavButton { background-color: transparent; color: #9098b0; border: none; border-left: 2px solid transparent; border-radius: 0; padding: 8px 16px; text-align: left; font-size: 12px; font-weight: 400; }
#NavButton:hover { background-color: #1a1d26; color: #e8eaf0; }
#NavButton[active="true"] { background-color: #1a1d26; color: #e8eaf0; border-left: 2px solid #7f77dd; font-weight: 500; }
#SidebarFooter { background-color: #111318; border-top: 1px solid #2e3347; padding: 10px 14px; }
#ModelNameLabel { font-family: "SF Mono", "Menlo", "Consolas", monospace; font-size: 11px; color: #9098b0; }
#ModelStatsLabel { font-size: 10px; color: #555e78; margin-top: 2px; }

/* ══════════════════════════════════════
   CHAT ZONE (ConsolePage)
══════════════════════════════════════ */
#ChatZone { background-color: #0a0b0f; }
#ChatHeader { background-color: #111318; border-bottom: 1px solid #2e3347; padding: 0 14px; min-height: 46px; }
#ChatHeaderTitle { font-size: 14px; font-weight: 500; color: #e8eaf0; }

/* ModeBadge — capsules colorées */
#ModeBadge { border-radius: 4px; padding: 2px 8px; font-size: 10px; font-weight: 600; letter-spacing: 0.05em; }
#ModeBadge[mode="RAG"] { background-color: rgba(29, 158, 117, 0.15); color: #1d9e75; border: 1px solid rgba(29, 158, 117, 0.3); }
#ModeBadge[mode="LOCAL"] { background-color: rgba(144, 152, 176, 0.1); color: #9098b0; border: 1px solid rgba(144, 152, 176, 0.2); }
#ModeBadge[mode="CLOUD"] { background-color: rgba(55, 138, 221, 0.12); color: #378add; border: 1px solid rgba(55, 138, 221, 0.25); }
#ModeBadge[mode="VERIFY"] { background-color: rgba(239, 159, 39, 0.12); color: #ef9f27; border: 1px solid rgba(239, 159, 39, 0.25); }
#ModeBadge[mode="PLAN"] { background-color: rgba(127, 119, 221, 0.12); color: #7f77dd; border: 1px solid rgba(127, 119, 221, 0.25); }

/* ConfidenceWidget */
#ConfidenceWidget { background-color: transparent; padding: 0; }
#ConfidenceLabel { font-size: 10px; color: #555e78; margin-right: 4px; }
#ConfidenceBar { background-color: #2e3347; border-radius: 2px; min-height: 4px; max-height: 4px; min-width: 64px; }
#ConfidenceBar::chunk { border-radius: 2px; }
#ConfidenceBar[level="high"]::chunk { background-color: #639922; }
#ConfidenceBar[level="mid"]::chunk { background-color: #ef9f27; }
#ConfidenceBar[level="low"]::chunk { background-color: #e24b4a; }
#ConfidenceValue { font-size: 11px; font-weight: 500; min-width: 32px; }
#ConfidenceValue[level="high"] { color: #639922; }
#ConfidenceValue[level="mid"] { color: #ef9f27; }
#ConfidenceValue[level="low"] { color: #e24b4a; }

/* Messages Area */
#MessagesArea { background-color: #0a0b0f; border: none; }
#MessagesArea > QWidget { background-color: #0a0b0f; }
QScrollBar:vertical { background-color: transparent; width: 6px; border: none; }
QScrollBar::handle:vertical { background-color: #2e3347; border-radius: 3px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background-color: #555e78; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Bulles de chat */
#BubbleNuru { background-color: #111318; border: 1px solid #2e3347; border-radius: 10px; border-top-left-radius: 3px; padding: 10px 12px; }
#BubbleUser { background-color: #1a1d26; border: 1px solid #2e3347; border-radius: 10px; border-top-right-radius: 3px; padding: 10px 12px; }
#BubbleText { color: #e8eaf0; font-size: 13px; line-height: 1.6; background: transparent; }
#BubbleText[role="user"] { color: #c8cede; }

/* CitationBadge */
#CitationBadge { background-color: rgba(29, 158, 117, 0.1); color: #1d9e75; border: 1px solid rgba(29, 158, 117, 0.25); border-radius: 4px; padding: 2px 7px; font-size: 10px; font-weight: 500; }
#CitationBadge:hover { background-color: rgba(29, 158, 117, 0.2); border-color: rgba(29, 158, 117, 0.5); }

/* Bubble action buttons */
#BubbleAction { background-color: transparent; color: #555e78; border: 1px solid transparent; border-radius: 5px; padding: 0; font-size: 13px; min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px; }
#BubbleAction:hover { background-color: rgba(127, 119, 221, 0.15); color: #7f77dd; border: 1px solid rgba(127, 119, 221, 0.25); }
#BubbleAction[feedback="up"] { background-color: rgba(127, 119, 221, 0.2); color: #7f77dd; border: 1px solid rgba(127, 119, 221, 0.4); }
#BubbleAction[feedback="down"] { background-color: rgba(226, 75, 74, 0.12); color: #e24b4a; border: 1px solid rgba(226, 75, 74, 0.3); }
#BubbleAction[copied="true"] { background-color: rgba(99, 153, 34, 0.15); color: #639922; border: 1px solid rgba(99, 153, 34, 0.3); }

/* Confidence mini-bar dans les bulles */
#ConfidenceLabel { color: #555e78; font-size: 9px; font-weight: 600; background: transparent; }
#ConfidenceBarBg { background-color: #2e3347; border-radius: 2px; }
#ConfidenceFill { background-color: #639922; border-radius: 2px; }
#ConfidenceValue { color: #555e78; font-size: 9px; font-weight: 600; background: transparent; }
#ConfidenceFill[level="high"] { background-color: #639922; }
#ConfidenceFill[level="mid"] { background-color: #ef9f27; }
#ConfidenceFill[level="low"] { background-color: #e24b4a; }

/* TypingIndicator */
#TypingIndicator { background-color: #111318; border: 1px solid #2e3347; border-radius: 10px; border-top-left-radius: 3px; padding: 8px 14px; }

/* Input Area — objectNames depuis console_page.py */
#InputArea { background-color: #111318; border-top: 1px solid #2e3347; padding: 8px 10px 10px; }
#InputFrameV7 { background-color: #1a1d26; border: 1px solid #2e3347; border-radius: 10px; padding: 4px 6px; }
#InputFrameV7:focus-within { border-color: rgba(127, 119, 221, 0.4); }
QTextEdit#SmartTextEdit { background-color: transparent; border: none; color: #e8eaf0; font-size: 13px; selection-background-color: rgba(127, 119, 221, 0.25); padding: 4px 6px; min-height: 28px; max-height: 90px; }
QTextEdit#SmartTextEdit::placeholder { color: #555e78; }
#MicButton, #AttachButton, #StrictButton { background-color: transparent; border: 1px solid #2e3347; border-radius: 7px; color: #9098b0; min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px; font-size: 14px; padding: 0; }
#MicButton:hover, #AttachButton:hover, #StrictButton:hover { background-color: #242836; border-color: #555e78; color: #e8eaf0; }
#StrictButton:checked { background-color: rgba(127, 119, 221, 0.15); border-color: rgba(127, 119, 221, 0.4); color: #7f77dd; }
#SendButtonV7 { background-color: #1e2540; border: 1px solid rgba(127, 119, 221, 0.35); border-radius: 7px; color: #7f77dd; min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px; font-size: 14px; padding: 0; }
#SendButtonV7:hover { background-color: rgba(127, 119, 221, 0.2); border-color: rgba(127, 119, 221, 0.6); }
#SendButtonV7:pressed { background-color: rgba(127, 119, 221, 0.3); }
#SendButtonV7:disabled { background-color: #1a1d26; border-color: #2e3347; color: #555e78; }
#NewChatHeaderBtn { background-color: transparent; border: 1px solid #2e3347; border-radius: 7px; color: #9098b0; min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px; font-size: 14px; padding: 0; }
#NewChatHeaderBtn:hover { background-color: #242836; border-color: #555e78; color: #e8eaf0; }
#InputHint { color: #555e78; font-size: 10px; padding: 2px 14px 0; }

/* ══════════════════════════════════════
   METRICS PANEL (MetricsPanel)
══════════════════════════════════════ */
#MetricsPanel { background-color: #111318; border-left: 1px solid #2e3347; min-width: 200px; max-width: 220px; }
#MetricsPanelTitle { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; color: #555e78; text-transform: uppercase; padding: 12px 12px 8px; border-bottom: 1px solid #2e3347; }

/* StrategyBadge */
#StrategyBadge { background-color: #1a1d26; border: 1px solid #2e3347; border-radius: 8px; padding: 7px 10px; margin: 8px 10px 4px; }
#StrategyNameLabel { font-size: 11px; font-weight: 600; color: #e8eaf0; }
#StrategySubLabel { font-size: 10px; color: #555e78; margin-top: 1px; }

/* MetricMiniBar */
#MetricMiniBar { background-color: transparent; border: none; padding: 4px 12px; }
#MetricCardLabel { font-size: 10px; color: #9098b0; }
#MetricCardValue { font-size: 12px; font-weight: 500; color: #e8eaf0; }
#MetricMiniBar QProgressBar { background-color: #2e3347; border: none; border-radius: 2px; min-height: 3px; max-height: 3px; }
#MetricMiniBar QProgressBar::chunk { border-radius: 2px; }
#MetricMiniBar[metric="ram"] QProgressBar::chunk { background-color: #ef9f27; }
#MetricMiniBar[metric="rag"] QProgressBar::chunk { background-color: #639922; }
#MetricMiniBar[metric="tokens"] QProgressBar::chunk { background-color: #378add; }
#MetricMiniBar[metric="traces"] QProgressBar::chunk { background-color: #7f77dd; }

/* ══════════════════════════════════════
   PAGES SECONDAIRES
══════════════════════════════════════ */
#PageTitle { font-size: 16px; font-weight: 500; color: #e8eaf0; padding: 16px 20px 8px; }
#PageSubtitle { font-size: 12px; color: #9098b0; padding: 0 20px 16px; }
#ContentCard { background-color: #111318; border: 1px solid #2e3347; border-radius: 10px; padding: 14px 16px; margin: 4px 0; }
#ContentCard:hover { border-color: #555e78; }

/* Document items */
#DocItem { background-color: #111318; border: 1px solid #2e3347; border-radius: 8px; padding: 10px 12px; }
#DocItem:hover { background-color: #1a1d26; border-color: rgba(127, 119, 221, 0.3); }
#DocNameLabel { font-size: 12px; font-weight: 500; color: #e8eaf0; }
#DocMetaLabel { font-size: 10px; color: #555e78; margin-top: 2px; }
#DocStatusBadge { border-radius: 4px; padding: 1px 6px; font-size: 10px; font-weight: 600; }
#DocStatusBadge[status="indexed"] { background-color: rgba(29, 158, 117, 0.12); color: #1d9e75; border: 1px solid rgba(29, 158, 117, 0.25); }
#DocStatusBadge[status="pending"] { background-color: rgba(239, 159, 39, 0.12); color: #ef9f27; border: 1px solid rgba(239, 159, 39, 0.25); }
#DocStatusBadge[status="error"] { background-color: rgba(226, 75, 74, 0.12); color: #e24b4a; border: 1px solid rgba(226, 75, 74, 0.25); }

/* Nuru Brain */
#BrainFileItem { background-color: #111318; border: 1px solid #2e3347; border-radius: 6px; padding: 8px 12px; }
#BrainFileItem:hover { background-color: #1a1d26; border-color: rgba(29, 158, 117, 0.3); }
#BrainFileName { font-family: "SF Mono", "Menlo", "Consolas", monospace; font-size: 11px; color: #9098b0; }
#BrainFileDate { font-size: 10px; color: #555e78; }

/* Settings */
#SettingLabel { font-size: 12px; color: #e8eaf0; font-weight: 500; }
#SettingDesc { font-size: 11px; color: #9098b0; margin-top: 2px; }
#SettingRow { background-color: transparent; border-bottom: 1px solid #2e3347; padding: 12px 0; }
#SettingRow:last-child { border-bottom: none; }
#LogsView { background-color: #0a0b0f; color: #9098b0; font-family: "SF Mono", "Menlo", "Consolas", monospace; font-size: 11px; border: none; padding: 12px; }

/* ══════════════════════════════════════
   COMPOSANTS COMMUNS
══════════════════════════════════════ */
QPushButton { background-color: #1a1d26; color: #9098b0; border: 1px solid #2e3347; border-radius: 7px; padding: 6px 14px; font-size: 12px; font-weight: 500; }
QPushButton:hover { background-color: #242836; color: #e8eaf0; border-color: #555e78; }
QPushButton:pressed { background-color: #2e3347; }
QPushButton:disabled { color: #555e78; border-color: #1a1d26; }
QPushButton#PrimaryBtn { background-color: rgba(127, 119, 221, 0.15); color: #7f77dd; border: 1px solid rgba(127, 119, 221, 0.35); }
QPushButton#PrimaryBtn:hover { background-color: rgba(127, 119, 221, 0.25); border-color: rgba(127, 119, 221, 0.6); }
QPushButton#DangerBtn { background-color: rgba(226, 75, 74, 0.1); color: #e24b4a; border: 1px solid rgba(226, 75, 74, 0.25); }
QPushButton#DangerBtn:hover { background-color: rgba(226, 75, 74, 0.2); }
QPushButton#GhostBtn { background-color: transparent; color: #9098b0; border: 1px solid transparent; }
QPushButton#GhostBtn:hover { color: #e8eaf0; }

QLineEdit, QTextEdit { background-color: #1a1d26; color: #e8eaf0; border: 1px solid #2e3347; border-radius: 7px; padding: 7px 10px; font-size: 13px; selection-background-color: rgba(127, 119, 221, 0.25); }
QLineEdit:focus, QTextEdit:focus { border-color: rgba(127, 119, 221, 0.4); background-color: #1e2230; }
QLineEdit::placeholder, QTextEdit::placeholder { color: #555e78; }

QComboBox { background-color: #1a1d26; color: #e8eaf0; border: 1px solid #2e3347; border-radius: 7px; padding: 6px 10px; font-size: 12px; min-width: 120px; }
QComboBox:hover { border-color: #555e78; }
QComboBox:focus { border-color: rgba(127, 119, 221, 0.4); }
QComboBox::drop-down { border: none; padding-right: 8px; }
QComboBox::down-arrow { width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #1a1d26; border: 1px solid #2e3347; border-radius: 7px; color: #e8eaf0; selection-background-color: #242836; padding: 4px; }

QCheckBox, QRadioButton { color: #9098b0; font-size: 12px; spacing: 8px; }
QCheckBox:hover, QRadioButton:hover { color: #e8eaf0; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #555e78; border-radius: 4px; background-color: #1a1d26; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background-color: rgba(127, 119, 221, 0.3); border-color: #7f77dd; }
QRadioButton::indicator { border-radius: 8px; }

QSlider::groove:horizontal { height: 4px; background-color: #2e3347; border-radius: 2px; }
QSlider::handle:horizontal { background-color: #7f77dd; width: 14px; height: 14px; border-radius: 7px; margin: -5px 0; }
QSlider::sub-page:horizontal { background-color: rgba(127, 119, 221, 0.5); border-radius: 2px; }

QToolTip { background-color: #1a1d26; color: #e8eaf0; border: 1px solid #2e3347; border-radius: 6px; padding: 5px 9px; font-size: 11px; }

QProgressBar { background-color: #2e3347; border: none; border-radius: 4px; text-align: center; min-height: 6px; max-height: 6px; }
QProgressBar::chunk { background-color: #7f77dd; border-radius: 4px; }

QTableWidget, QTreeWidget, QListWidget { background-color: #0a0b0f; color: #e8eaf0; border: 1px solid #2e3347; border-radius: 8px; selection-background-color: #1a1d26; outline: none; font-size: 12px; }
QTableWidget::item, QTreeWidget::item, QListWidget::item { padding: 6px 10px; border-bottom: 1px solid #1a1d26; }
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected { background-color: #242836; }
QHeaderView::section { background-color: #111318; color: #555e78; border: none; border-bottom: 1px solid #2e3347; padding: 6px 10px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }

QTabWidget::pane { border: 1px solid #2e3347; border-radius: 8px; background-color: #111318; }
QTabBar::tab { background-color: transparent; color: #9098b0; border: none; border-bottom: 2px solid transparent; padding: 8px 16px; font-size: 12px; font-weight: 500; }
QTabBar::tab:selected { color: #e8eaf0; border-bottom: 2px solid #7f77dd; }
QTabBar::tab:hover:not(:selected) { color: #c8cede; }

QGroupBox { border: 1px solid #2e3347; border-radius: 8px; margin-top: 14px; padding: 12px 12px 14px; font-size: 11px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; padding: 0 6px; color: #555e78; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; }

QMenu { background-color: #1a1d26; border: 1px solid #2e3347; border-radius: 8px; padding: 4px; color: #e8eaf0; font-size: 12px; }
QMenu::item { padding: 6px 12px; border-radius: 5px; }
QMenu::item:selected { background-color: #242836; }
QMenu::separator { height: 1px; background-color: #2e3347; margin: 4px 0; }

QMessageBox { background-color: #111318; }
QMessageBox QLabel { color: #e8eaf0; }
