/* ═══════════════════════════════════════════════════════════════════
   NURU V12 — Thème DM-1 "Deep Cyan"
   Design system ambient, sombre, élégant — palette #00D4FF cyan
   Palette : #0A0E17 fond, #00D4FF accent, arrondis 12px
═══════════════════════════════════════════════════════════════════ */

/* ── Base DM-1 ─────────────────────────────────────────────────── */

QMainWindow {
    background-color: #0A0E17;
}
QWidget {
    background-color: transparent;
    color: #E8ECF1;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
}

/* ── SIDEBAR ──────────────────────────────────────────────────── */

#Sidebar {
    background-color: #151B26;
    border-right: 1px solid rgba(0, 212, 255, 0.12);
    min-width: 60px;
    max-width: 220px;
}
#SidebarHeader {
    background-color: #151B26;
    border-bottom: 1px solid rgba(0, 212, 255, 0.12);
    padding: 18px 14px 14px;
}
#LogoLabel {
    font-size: 18px;
    font-weight: 700;
    color: #E8ECF1;
    letter-spacing: -0.02em;
}
#VersionBadge {
    background-color: rgba(0, 212, 255, 0.08);
    color: #00D4FF;
    border: 1px solid rgba(0, 212, 255, 0.20);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#NavSectionLabel {
    color: #4A5568;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 14px 14px 6px;
}
#NavButton {
    background-color: transparent;
    color: #8B95A5;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    text-align: left;
    font-size: 13px;
    font-weight: 400;
    margin: 1px 8px;
    letter-spacing: 0.01em;
}
#NavButton:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #E8ECF1;
}
#NavButton[active="true"] {
    background-color: rgba(0, 212, 255, 0.12);
    color: #00D4FF;
    font-weight: 500;
}
#CollapseSidebarBtn {
    background-color: transparent;
    color: #4A5568;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    padding: 0;
}
#CollapseSidebarBtn:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #E8ECF1;
}

/* NavSectionToggle */
#NavSectionToggle {
    background-color: transparent;
    color: #4A5568;
    border: 1px dashed rgba(0, 212, 255, 0.20);
    border-radius: 6px;
    padding: 6px 14px;
    text-align: left;
    font-size: 11px;
    font-weight: 500;
    margin: 6px 8px 2px;
    letter-spacing: 0.04em;
}
#NavSectionToggle:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #8B95A5;
    border-color: rgba(0, 212, 255, 0.30);
}
#NavSectionToggle:checked {
    background-color: rgba(0, 212, 255, 0.06);
    color: #00D4FF;
    border-color: rgba(0, 212, 255, 0.20);
}

/* NavButton secondaire */
#NavButton[secondary="true"] {
    padding: 6px 14px 6px 24px;
    font-size: 12px;
    color: #8B95A5;
}
#NavButton[secondary="true"]:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #E8ECF1;
}
#NavButton[secondary="true"][active="true"] {
    background-color: rgba(0, 212, 255, 0.06);
    color: #00D4FF;
}

/* Mini-mode */
#NavButton[mini="true"] {
    padding: 8px 4px;
    margin: 1px 4px;
    text-align: center;
    font-size: 16px;
}
#NavButton[mini="true"]:hover {
    background-color: rgba(0, 212, 255, 0.08);
}
#NavButton[mini="true"][active="true"] {
    background-color: rgba(0, 212, 255, 0.12);
}

/* Recent Documents */
#RecentDocuments {
    background-color: transparent;
    margin: 2px 8px;
    padding: 6px 0;
}
#RecentDocumentsHeader {
    font-size: 11px;
    font-weight: 600;
    color: #4A5568;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 8px 6px 4px;
}
#RecentDocItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    color: #8B95A5;
}
#RecentDocItem:hover {
    background-color: rgba(0, 212, 255, 0.06);
    color: #E8ECF1;
}
#DocDot {
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
    border-radius: 2.5px;
}
#DocDot[indexed="true"] {
    background-color: #00E599;
}
#DocDot[partial="true"] {
    background-color: #FFB800;
}

/* CloudStatusBadge */
#CloudStatusBadge {
    background-color: rgba(0, 212, 255, 0.04);
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 6px;
    padding: 8px 10px;
    margin: 0 8px;
}
#CloudStatusDot {
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #00E599;
}
#CloudStatusText {
    font-size: 10px;
    color: #00E599;
    letter-spacing: 0.03em;
}

/* ModelInfoFooter */
#ModelInfoFooter {
    background-color: transparent;
    color: #4A5568;
    font-size: 11px;
    padding: 12px 14px;
    border-top: 1px solid rgba(0, 212, 255, 0.12);
}

/* ── CHAT ZONE ────────────────────────────────────────────────────── */

#ChatZone {
    background-color: #0A0E17;
}
#ChatHeader {
    background-color: #151B26;
    border-bottom: 1px solid rgba(0, 212, 255, 0.12);
    padding: 0 20px;
    min-height: 48px;
}
#ChatHeaderTitle {
    font-size: 14px;
    font-weight: 500;
    color: #8B95A5;
}
#ChatHeader .QComboBox {
    background-color: #1C2433;
    color: #E8ECF1;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    min-width: 120px;
}
#ChatHeader .QComboBox:hover {
    border-color: rgba(0, 212, 255, 0.25);
}
#ChatHeader .QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}
#ChatHeader .QComboBox QAbstractItemView {
    background-color: #1C2433;
    color: #E8ECF1;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 6px;
    selection-background-color: rgba(0, 212, 255, 0.15);
    selection-color: #00D4FF;
}

/* ModeBadge */
#ModeBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#ModeBadge[mode="RAG"] {
    background-color: rgba(0, 212, 255, 0.12);
    color: #00D4FF;
    border: 0.5px solid rgba(0, 212, 255, 0.20);
}
#ModeBadge[mode="LOCAL"] {
    background-color: rgba(0, 229, 153, 0.12);
    color: #00E599;
    border: 0.5px solid rgba(0, 229, 153, 0.20);
}
#ModeBadge[mode="CLOUD"] {
    background-color: rgba(0, 212, 255, 0.12);
    color: #00D4FF;
    border: 0.5px solid rgba(0, 212, 255, 0.20);
}
#ModeBadge[mode="VERIFY"] {
    background-color: rgba(255, 184, 0, 0.12);
    color: #FFB800;
    border: 0.5px solid rgba(255, 184, 0, 0.20);
}
#ModeBadge[mode="PLAN"] {
    background-color: rgba(0, 212, 255, 0.12);
    color: #00D4FF;
    border: 0.5px solid rgba(0, 212, 255, 0.20);
}

/* ConfidenceWidget */
#ConfidenceWidget {
    background-color: transparent;
    padding: 0;
}
#ConfidenceLabel {
    font-size: 11px;
    color: #4A5568;
    margin-right: 6px;
}
#ConfidenceBar {
    background-color: rgba(0, 212, 255, 0.12);
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
    min-width: 60px;
}
#ConfidenceBar::chunk {
    border-radius: 2px;
}
#ConfidenceBar[level="high"]::chunk {
    background-color: #00E599;
}
#ConfidenceBar[level="mid"]::chunk {
    background-color: #FFB800;
}
#ConfidenceBar[level="low"]::chunk {
    background-color: #FF4D6A;
}
#ConfidenceValue {
    font-size: 11px;
    font-weight: 500;
    min-width: 30px;
}
#ConfidenceValue[level="high"] {
    color: #00E599;
}
#ConfidenceValue[level="mid"] {
    color: #FFB800;
}
#ConfidenceValue[level="low"] {
    color: #FF4D6A;
}

/* Messages Area */
#MessagesArea {
    background-color: #0A0E17;
    border: none;
}
#MessagesArea > QWidget {
    background-color: #0A0E17;
}
#ChatContent {
    max-width: 720px;
    margin: 0px auto;
}

/* Scrollbar DM-1 */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: rgba(0, 212, 255, 0.20);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 212, 255, 0.35);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── BULLES DE CHAT ───────────────────────────────────────────── */

#BubbleNuru {
    background-color: #151B26;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 4px 12px 12px 12px;
    padding: 10px 14px;
}
#BubbleUser {
    background-color: rgba(0, 212, 255, 0.10);
    border: 1px solid rgba(0, 212, 255, 0.20);
    border-radius: 12px 4px 12px 12px;
    padding: 10px 14px;
}
#BubbleText {
    color: #E8ECF1;
    font-size: 13px;
    line-height: 1.55;
    background: transparent;
}
#BubbleText[role="user"] {
    color: #C0C8D4;
}
#MessageRow {
    padding: 6px 0;
}

/* ── FOOTER BULLE ────────────────────────────────────────────── */

#BubbleFooter {
    background: transparent;
    padding: 6px 0 2px;
}
#BubbleFooterLabel {
    font-size: 10px;
    color: #4A5568;
    letter-spacing: 0.02em;
}
#BubbleFooter QPushButton {
    background-color: transparent;
    border: none;
    color: #4A5568;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 3px;
}
#BubbleFooter QPushButton:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #00D4FF;
}

/* ── INPUT AREA ───────────────────────────────────────────────── */

#InputFrameV7 {
    background-color: #151B26;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 10px;
    padding: 8px 12px;
    margin: 12px 20px;
    min-height: 40px;
}
#InputFrameV7:focus-within {
    border-color: rgba(0, 212, 255, 0.40);
}
#InputFrameV7 QPlainTextEdit {
    background-color: transparent;
    color: #E8ECF1;
    border: none;
    font-size: 13px;
    padding: 4px;
    selection-background-color: rgba(0, 212, 255, 0.25);
}
#SendButtonV7 {
    background-color: rgba(0, 212, 255, 0.10);
    color: #00D4FF;
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
}
#SendButtonV7:hover {
    background-color: rgba(0, 212, 255, 0.20);
    border-color: rgba(0, 212, 255, 0.30);
}
#SendButtonV7:pressed {
    background-color: rgba(0, 212, 255, 0.30);
}
#InputArea QPushButton {
    background-color: transparent;
    color: #4A5568;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}
#InputArea QPushButton:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #00D4FF;
}
#InputArea QPushButton[checked="true"] {
    color: #00D4FF;
    background-color: rgba(0, 212, 255, 0.08);
}

/* ── NOTIFICATIONS ──────────────────────────────────────────────────── */

#NotificationWidget {
    background-color: #1C2433;
    border: 1px solid rgba(0, 212, 255, 0.20);
    border-radius: 10px;
    padding: 12px 16px;
}
#NotificationWidget QLabel {
    font-size: 11px;
    color: #E8ECF1;
}

/* ── CONVERSATION LIST ─────────────────────────────────────────── */

#ConversationList {
    background-color: transparent;
    padding: 0;
    margin: 0 4px;
}
#ConversationListHeader {
    font-size: 11px;
    font-weight: 600;
    color: #4A5568;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 10px 10px 4px;
}
#ConversationItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 1px 4px;
}
#ConversationItem:hover {
    background-color: rgba(0, 212, 255, 0.06);
}
#ConversationItem QLabel#ConvTitle {
    font-size: 12px;
    font-weight: 500;
    color: #E8ECF1;
}
#ConversationItem QLabel#ConvDate {
    font-size: 10px;
    color: #4A5568;
}
#NewConversationBtn {
    background-color: rgba(0, 212, 255, 0.08);
    color: #00D4FF;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 500;
    margin: 4px 8px;
    text-align: center;
}
#NewConversationBtn:hover {
    background-color: rgba(0, 212, 255, 0.15);
}

/* ── RIGHT PANEL / METRICS ────────────────────────────────────── */

#RightPanel {
    background-color: #151B26;
    border-left: 1px solid rgba(0, 212, 255, 0.12);
    min-width: 260px;
    max-width: 300px;
}
#RightPanelHeader {
    font-size: 12px;
    font-weight: 600;
    color: #4A5568;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 16px 14px 8px;
}
#RightPanel QLabel#MetricLabel {
    color: #4A5568;
    font-size: 11px;
}
#RightPanel QLabel#MetricValue {
    color: #E8ECF1;
    font-size: 14px;
    font-weight: 600;
}
#RightPanel QLabel#MetricSubtitle {
    color: #4A5568;
    font-size: 10px;
}

/* ── PLACEHOLDER PAGES ────────────────────────────────────────── */

#PlaceholderPageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #E8ECF1;
    margin-bottom: 8px;
}
#PlaceholderPageDesc {
    font-size: 13px;
    color: #8B95A5;
    line-height: 1.5;
}

/* ── TABS ─────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: #0A0E17;
    border: none;
    border-top: 1px solid rgba(0, 212, 255, 0.12);
}
QTabBar::tab {
    background-color: transparent;
    color: #8B95A5;
    border: none;
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #E8ECF1;
}
QTabBar::tab:selected {
    color: #00D4FF;
    border-bottom: 2px solid #00D4FF;
}

/* ── PROGRESS BAR ─────────────────────────────────────────────── */

QProgressBar {
    background-color: rgba(0, 212, 255, 0.12);
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #00D4FF;
    border-radius: 3px;
}
QProgressBar::chunk[status="success"]::chunk {
    background-color: #00E599;
}

/* ── TOOLTIP ──────────────────────────────────────────────────── */

QToolTip {
    background-color: #151B26;
    color: #E8ECF1;
    border: 1px solid rgba(0, 212, 255, 0.20);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ── RELOAD BADGE ─────────────────────────────────────────────── */

#ReloadBadge {
    background-color: rgba(255, 184, 0, 0.10);
    color: #FFB800;
    border: 1px solid rgba(255, 184, 0, 0.15);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 500;
    margin: 4px 8px;
}

/* ── STAT CARD ────────────────────────────────────────────────── */

#StatCard {
    background-color: #151B26;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 10px;
    padding: 12px;
}
#StatCardTitle {
    font-size: 10px;
    font-weight: 500;
    color: #4A5568;
    letter-spacing: 0.02em;
}
#StatCardValue {
    font-size: 22px;
    font-weight: 700;
    color: #E8ECF1;
}
#StatCardIcon {
    font-size: 18px;
}

/* MiniStatCard */
#MiniStatCard {
    background-color: #151B26;
    border: 1px solid rgba(0, 212, 255, 0.12);
    border-radius: 8px;
    padding: 8px;
}
#MiniStatCardLabel {
    font-size: 10px;
    font-weight: 500;
    color: #4A5568;
}
#MiniStatCardValue {
    font-size: 16px;
    font-weight: 700;
    color: #E8ECF1;
}
#MiniStatCardSubtitle {
    font-size: 10px;
    color: #4A5568;
}

/* ── THEME TOGGLE ─────────────────────────────────────────────── */

#ThemeToggleBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    padding: 2px;
}
#ThemeToggleBtn:hover {
    background-color: rgba(0, 212, 255, 0.10);
}
#ThemeLabel {
    font-size: 10px;
    color: #4A5568;
}
#ThemeRow {
    background-color: transparent;
    border-top: 1px solid rgba(0, 212, 255, 0.12);
}

/* ── THINKING BLOCK ────────────────────────────────────────────── */

#ThinkingBlock {
    background-color: rgba(0, 212, 255, 0.04);
    border-left: 2px solid rgba(0, 212, 255, 0.30);
    border-radius: 6px;
    padding: 8px 12px;
    margin: 4px 0 0 0;
    font-size: 12px;
    color: #8B95A5;
    line-height: 1.5;
}
#ThinkingToggleBtn {
    background-color: transparent;
    border: none;
    color: #4A5568;
    font-size: 11px;
    padding: 4px 0;
    text-align: left;
}
#ThinkingToggleBtn:hover {
    color: #00D4FF;
}

/* ══════════════════════════════
   V12 — Quick Action Chips
   ══════════════════════════════ */
#QuickActionChip {
    background-color: rgba(0, 212, 255, 0.10);
    border: 1px solid rgba(0, 212, 255, 0.20);
    border-radius: 14px;
    color: #A0D0E8;
    font-size: 11px;
    padding: 4px 12px;
    min-height: 24px;
}
#QuickActionChip:hover {
    background-color: rgba(0, 212, 255, 0.20);
    border-color: rgba(0, 212, 255, 0.40);
    color: #C0D0E8;
}
#QuickActionChip:pressed {
    background-color: rgba(0, 212, 255, 0.30);
}
#QuickChipsContainer {
    background-color: transparent;
}
