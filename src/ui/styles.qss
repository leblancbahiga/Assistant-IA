/* ===================================================================
   NURU V6 — Style épuré (Anthracite / Bleu électrique / Vert acide)
   
   Palette : fond #0D1117, cartes #161B22, bordures #1F2937
             bleu #00A3FF, vert #39FF14, ambre #FFB000
             texte #E5E7EB, secondaire #6B7280
   =================================================================== */

QWidget {
    font-family: "SF Mono", "Consolas", "Fira Code", monospace;
    font-size: 13px;
    color: #E5E7EB;
}

/* Panneau central */
#CentralContainer {
    background-color: #0D1117;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* Sidebar */
#Sidebar {
    background-color: #0D1117;
    border-right: 1px solid #1F2937;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
}

#AppName {
    font-size: 22px;
    font-weight: 900;
    color: #00A3FF;
    letter-spacing: 4px;
}

#AppVersion {
    color: #6B7280;
    font-weight: bold;
    font-size: 10px;
}

/* Bouton Nouveau Chat */
#NewChatBtn {
    background-color: #00A3FF;
    color: #0D1117;
    border: none;
    border-radius: 8px;
    font-weight: 900;
    font-size: 13px;
}
#NewChatBtn:hover {
    background-color: #39FF14;
    color: #0D1117;
}

/* Menus Sidebar */
#SidebarMenu {
    background: transparent;
    border: none;
    font-size: 13px;
}
#SidebarMenu::item {
    color: #6B7280;
    border-radius: 6px;
    padding: 10px;
    margin: 2px 0;
}
#SidebarMenu::item:selected {
    color: #00A3FF;
    background-color: rgba(0, 163, 255, 0.1);
    border-left: 3px solid #00A3FF;
}

/* Raccourcis */
#ShortcutBtn {
    background-color: transparent;
    border: 1px solid #1F2937;
    border-radius: 6px;
    color: #6B7280;
    text-align: left;
    padding-left: 12px;
    font-size: 12px;
}
#ShortcutBtn:hover {
    background-color: rgba(0, 163, 255, 0.08);
    color: #E5E7EB;
    border-color: #00A3FF;
}

/* Pro Card */
#ProCard {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 rgba(0, 163, 255, 0.1),
                                      stop:1 rgba(57, 255, 20, 0.05));
    border: 1px solid #00A3FF;
    border-radius: 10px;
    padding: 12px;
}
#ProBtn {
    background-color: #00A3FF;
    color: #0D1117;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
}
#ProBtn:hover {
    background-color: #39FF14;
}

/* HUD Métriques (overlay legacy — caché si non utilisé) */
#MetricsOverlay { background: transparent; }
#MetricsContainer {
    background-color: #161B22;
    border: 1px solid #1F2937;
    border-radius: 8px;
}
#MetricsText, #MetricsPct { color: #6B7280; font-weight: bold; }
#MetricsText { font-size: 10px; }

/* Barre RAM */
QProgressBar#RamBar {
    background-color: #1F2937;
    border: none;
    border-radius: 2px;
    height: 6px;
}
QProgressBar#RamBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #39FF14,
                                      stop:1 #00A3FF);
    border-radius: 2px;
}

/* Bulles de chat V6 */
#ChatBubbleAssistant {
    background-color: #161B22;
    border-left: 3px solid #00A3FF;
    border-radius: 10px;
    padding: 14px;
    margin: 4px 0;
}

#ChatBubbleUser {
    background-color: #1A1D24;
    border-left: 3px solid #39FF14;
    border-radius: 10px;
    padding: 14px;
    margin: 4px 0;
}

/* Bulles legacy V5 */
#BubbleFrame {
    background-color: rgba(0, 163, 255, 0.08);
    border: 1px solid rgba(0, 163, 255, 0.3);
    border-radius: 10px;
    border-bottom-right-radius: 0px;
}
#AssistantBubbleFrame {
    background-color: rgba(57, 255, 20, 0.05);
    border: 1px solid rgba(57, 255, 20, 0.2);
    border-radius: 10px;
    border-bottom-left-radius: 0px;
}

/* Zone de saisie */
#InputFrame {
    background-color: #161B22;
    border: 1px solid #1F2937;
    border-radius: 16px;
}
#InputField {
    background: transparent;
    border: none;
    color: #E5E7EB;
    font-size: 14px;
    padding: 8px 4px;
}
#InputField:focus {
    border: none;
    outline: none;
}

/* Bouton Envoyer */
#SendButton {
    background-color: #00A3FF;
    color: #0D1117;
    border: none;
    border-radius: 16px;
    font-weight: bold;
    font-size: 14px;
}
#SendButton:hover {
    background-color: #39FF14;
}

/* Bouton Web */
#WebSearchBtn {
    background-color: transparent;
    color: #6B7280;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
}
#WebSearchBtn:checked {
    background-color: #00A3FF;
    color: #0D1117;
    border: 1px solid #00A3FF;
}

/* Clear / Feedback */
#ClearBtn {
    background-color: transparent;
    border: 1px solid #1F2937;
    border-radius: 8px;
    color: #6B7280;
    font-size: 10px;
}
#ClearBtn:hover {
    background-color: #00A3FF;
    color: #0D1117;
}

/* Feedback buttons */
#BtnFeedbackUp, #BtnFeedbackDown {
    background: transparent;
    border: none;
    color: #6B7280;
    font-size: 12px;
}
#BtnFeedbackUp:hover, #BtnFeedbackUp:checked { color: #39FF14; }
#BtnFeedbackDown:hover, #BtnFeedbackDown:checked { color: #ef4444; }

/* Scrollbar */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #1F2937;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #00A3FF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

/* Labels */
#PanelTitle {
    color: #6B7280;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

#InputHint { color: #4B5563; font-size: 10px; }

/* Module circles */
#ModuleCircleActive {
    background-color: #39FF14;
    border-radius: 20px;
}
#ModuleCircleInactive {
    background-color: #1F2937;
    border-radius: 20px;
}

/* Collapse button */
#CollapseBtn {
    background: transparent;
    color: #6B7280;
    border: none;
    font-size: 14px;
}

/* MetricCard */
#MetricCard {
    background-color: #161B22;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 8px;
}
#MetricTitle { color: #6B7280; font-size: 10px; font-weight: bold; }
#MetricValue {
    font-size: 16px;
    font-weight: bold;
    color: #00A3FF;
}
#MetricSparkline { color: rgba(0, 163, 255, 0.3); font-size: 10px; }

/* Minimize btn */
#MinimizeBtn {
    background-color: transparent;
    color: #6B7280;
    border: 1px solid #1F2937;
    border-radius: 4px;
    font-size: 12px;
}
#MinimizeBtn:hover {
    background-color: #00A3FF;
    color: #0D1117;
}
