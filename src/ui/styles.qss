/* ═══════════════════════════════════════════════════════════════════
   NURU V11.1 — Thème "Midnight Indigo"
   Design system moderne, sombre, élégant — inspiré Linear/Notion
   Palette : #0D0D12 fond, #6366f1 accent, arrondis 8px
═══════════════════════════════════════════════════════════════════ */

/* ── Base ─────────────────────────────────────────────────────── */

QMainWindow {
    background-color: #0D0D12;
}
QWidget {
    background-color: transparent;
    color: #E5E5EC;
    font-family: "SF Pro Text", "Inter", -apple-system, sans-serif;
    font-size: 13px;
}

/* ── SIDEBAR ──────────────────────────────────────────────────── */

#Sidebar {
    background-color: #0F0F14;
    border-right: 1px solid #1C1C26;
    min-width: 60px;
    max-width: 220px;
}
#SidebarHeader {
    background-color: #0F0F14;
    border-bottom: 1px solid #1C1C26;
    padding: 18px 14px 14px;
}
#LogoLabel {
    font-size: 18px;
    font-weight: 700;
    color: #E5E5EC;
    letter-spacing: -0.02em;
}
#VersionBadge {
    background-color: #1A1A28;
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#NavSectionLabel {
    color: #5A5A6E;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 14px 14px 6px;
}
#NavButton {
    background-color: transparent;
    color: #7A7A8E;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    text-align: left;
    font-size: 12px;
    font-weight: 400;
    margin: 1px 8px;
    letter-spacing: 0.01em;
}
#NavButton:hover {
    background-color: #1A1A24;
    color: #A0A0B8;
}
#NavButton[active="true"] {
    background-color: rgba(99, 102, 241, 0.08);
    color: #818cf8;
    font-weight: 500;
}
#CollapseSidebarBtn {
    background-color: transparent;
    color: #5A5A6E;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    padding: 0;
}
#CollapseSidebarBtn:hover {
    background-color: #1E1E28;
    color: #A0A0B8;
}

/* V11.2 (Sprint 1) — Section toggle "⋯ Plus" */
#NavSectionToggle {
    background-color: transparent;
    color: #5A5A6E;
    border: 1px dashed #252530;
    border-radius: 6px;
    padding: 6px 14px;
    text-align: left;
    font-size: 10px;
    font-weight: 500;
    margin: 6px 8px 2px;
    letter-spacing: 0.04em;
}
#NavSectionToggle:hover {
    background-color: #1A1A24;
    color: #7A7A9E;
    border-color: #35354A;
}
#NavSectionToggle:checked {
    background-color: rgba(99, 102, 241, 0.06);
    color: #818cf8;
    border-color: rgba(99, 102, 241, 0.2);
}

/* V11.2 (Sprint 1) — Boutons secondaires (sous "⋯ Plus") */
#NavButton[secondary="true"] {
    padding: 6px 14px 6px 24px;
    font-size: 11px;
    color: #6A6A7E;
}
#NavButton[secondary="true"]:hover {
    background-color: #1A1A24;
    color: #9A9AB0;
}
#NavButton[secondary="true"][active="true"] {
    background-color: rgba(99, 102, 241, 0.06);
    color: #7A8cff;
}

/* V11.2 (Sprint 1) — Mini-mode sidebar (icônes seules, 60px) */
#NavButton[mini="true"] {
    padding: 8px 4px;
    margin: 1px 4px;
    text-align: center;
    font-size: 16px;
}
#NavButton[mini="true"]:hover {
    background-color: #1A1A24;
}
#NavButton[mini="true"][active="true"] {
    background-color: rgba(99, 102, 241, 0.08);
}

/* Recent Documents (Module 2) */
#RecentDocuments {
    background-color: transparent;
    margin: 2px 8px;
    padding: 6px 0;
}
#RecentDocumentsHeader {
    font-size: 9px;
    font-weight: 600;
    color: #5A5A6E;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 8px 6px 4px;
}
#RecentDocItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 10.5px;
    color: #6A6A7E;
}
#RecentDocItem:hover {
    background-color: #1A1A24;
    color: #8A8AA0;
}
#DocDot {
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
    border-radius: 2.5px;
}
#DocDot[indexed="true"] {
    background-color: #22C55E;
}
#DocDot[partial="true"] {
    background-color: #F59E0B;
}

/* CloudStatusBadge */
#CloudStatusBadge {
    background-color: #12121C;
    border: 1px solid #1C1C2A;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 0 8px;
}
#CloudStatusDot {
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #22C55E;
}
#CloudStatusText {
    font-size: 10px;
    color: #22C55E;
    letter-spacing: 0.03em;
}

/* ModelInfoFooter */
#ModelInfoFooter {
    background-color: transparent;
    color: #5A5A6E;
    font-size: 10px;
    padding: 12px 14px;
    border-top: 1px solid #1C1C26;
}

/* ── CHAT ZONE (ConsolePage) ──────────────────────────────────── */

#ChatZone {
    background-color: #0D0D12;
}
#ChatHeader {
    background-color: #0F0F14;
    border-bottom: 1px solid #1C1C26;
    padding: 0 20px;
    min-height: 48px;
}
#ChatHeaderTitle {
    font-size: 13px;
    font-weight: 500;
    color: #7A7A8E;
}
#ChatHeader .QComboBox {
    background-color: #1A1A24;
    color: #E5E5EC;
    border: 1px solid #252530;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    min-width: 120px;
}
#ChatHeader .QComboBox:hover {
    border-color: #3A3A4E;
}
#ChatHeader .QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}
#ChatHeader .QComboBox QAbstractItemView {
    background-color: #1A1A24;
    color: #E5E5EC;
    border: 1px solid #252530;
    border-radius: 6px;
    selection-background-color: rgba(99, 102, 241, 0.15);
    selection-color: #818cf8;
}

/* ModeBadge */
#ModeBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
#ModeBadge[mode="RAG"] {
    background-color: rgba(99, 102, 241, 0.12);
    color: #818cf8;
    border: 0.5px solid rgba(99, 102, 241, 0.2);
}
#ModeBadge[mode="LOCAL"] {
    background-color: rgba(34, 197, 94, 0.12);
    color: #22C55E;
    border: 0.5px solid rgba(34, 197, 94, 0.2);
}
#ModeBadge[mode="CLOUD"] {
    background-color: rgba(99, 102, 241, 0.12);
    color: #818cf8;
    border: 0.5px solid rgba(99, 102, 241, 0.2);
}
#ModeBadge[mode="VERIFY"] {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 0.5px solid rgba(245, 158, 11, 0.2);
}
#ModeBadge[mode="PLAN"] {
    background-color: rgba(129, 140, 248, 0.12);
    color: #818cf8;
    border: 0.5px solid rgba(129, 140, 248, 0.2);
}

/* ConfidenceWidget */
#ConfidenceWidget {
    background-color: transparent;
    padding: 0;
}
#ConfidenceLabel {
    font-size: 10px;
    color: #5A5A6E;
    margin-right: 6px;
}
#ConfidenceBar {
    background-color: #1C1C26;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
    min-width: 60px;
}
#ConfidenceBar::chunk {
    border-radius: 2px;
}
#ConfidenceBar[level="high"]::chunk {
    background-color: #22C55E;
}
#ConfidenceBar[level="mid"]::chunk {
    background-color: #F59E0B;
}
#ConfidenceBar[level="low"]::chunk {
    background-color: #EF4444;
}
#ConfidenceValue {
    font-size: 11px;
    font-weight: 500;
    min-width: 30px;
}
#ConfidenceValue[level="high"] {
    color: #22C55E;
}
#ConfidenceValue[level="mid"] {
    color: #F59E0B;
}
#ConfidenceValue[level="low"] {
    color: #EF4444;
}

/* Messages Area */
#MessagesArea {
    background-color: #0D0D12;
    border: none;
}
#MessagesArea > QWidget {
    background-color: #0D0D12;
}
#ChatContent {
    max-width: 720px;
    margin: 0px auto;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #1C1C26;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #3A3A4E;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── BULLES DE CHAT ───────────────────────────────────────────── */

#BubbleNuru {
    background-color: #12121C;
    border: 1px solid #1C1C2A;
    border-radius: 4px 12px 12px 12px;
    padding: 10px 14px;
}
#BubbleUser {
    background-color: #14141E;
    border: 1px solid #1E1E2E;
    border-right: 2px solid #6366f1;
    border-radius: 12px 4px 12px 12px;
    padding: 10px 14px;
}
#BubbleText {
    color: #C0C0D0;
    font-size: 12px;
    line-height: 1.55;
    background: transparent;
}
#BubbleText[role="user"] {
    color: #A0A0B8;
}
#MessageRow {
    padding: 6px 0;
}

/* ── FOOTER BULLE (ModeBadge + model_name) ────────────────────── */

#BubbleFooter {
    background: transparent;
    padding: 6px 0 2px;
}
#BubbleFooterLabel {
    font-size: 9.5px;
    color: #5A5A6E;
    letter-spacing: 0.02em;
}
#BubbleFooter QPushButton {
    background-color: transparent;
    border: none;
    color: #5A5A6E;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 3px;
}
#BubbleFooter QPushButton:hover {
    background-color: #1A1A24;
    color: #A0A0B8;
}

/* ── INPUT AREA ───────────────────────────────────────────────── */

#InputFrameV7 {
    background-color: #0F0F14;
    border: 1px solid #252530;
    border-radius: 10px;
    padding: 8px 12px;
    margin: 12px 20px;
    min-height: 40px;
}
#InputFrameV7:focus-within {
    border-color: rgba(99, 102, 241, 0.4);
}
#InputFrameV7 QPlainTextEdit {
    background-color: transparent;
    color: #D0D0DC;
    border: none;
    font-size: 12.5px;
    padding: 4px;
    selection-background-color: rgba(99, 102, 241, 0.3);
}
#SendButtonV7 {
    background-color: rgba(99, 102, 241, 0.1);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.15);
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
}
#SendButtonV7:hover {
    background-color: rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.3);
}
#SendButtonV7:pressed {
    background-color: rgba(99, 102, 241, 0.3);
}
#InputArea QPushButton {
    background-color: transparent;
    color: #5A5A6E;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}
#InputArea QPushButton:hover {
    background-color: #1A1A24;
    color: #A0A0B8;
}
#InputArea QPushButton[checked="true"] {
    color: #818cf8;
    background-color: rgba(99, 102, 241, 0.08);
}

/* ── NOTIFICATIONS / POPUPS ──────────────────────────────────── */

#NotificationWidget {
    background-color: #1A1A24;
    border: 1px solid #252530;
    border-radius: 10px;
    padding: 12px 16px;
}
#NotificationWidget QLabel {
    font-size: 11px;
    color: #C0C0D0;
}

/* ── CONVERSATION LIST (P0-J) ─────────────────────────────────── */

#ConversationList {
    background-color: transparent;
    padding: 0;
    margin: 0 4px;
}
#ConversationListHeader {
    font-size: 9px;
    font-weight: 600;
    color: #5A5A6E;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 10px 10px 4px;
}
#ConversationItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 1px 4px;
}
#ConversationItem:hover {
    background-color: #1A1A24;
}
#ConversationItem QLabel#ConvTitle {
    font-size: 11px;
    font-weight: 500;
    color: #B0B0C4;
}
#ConversationItem QLabel#ConvDate {
    font-size: 9px;
    color: #5A5A6E;
}
#NewConversationBtn {
    background-color: rgba(99, 102, 241, 0.08);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.12);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 500;
    margin: 4px 8px;
    text-align: center;
}
#NewConversationBtn:hover {
    background-color: rgba(99, 102, 241, 0.15);
}

/* ── RIGHT PANEL / METRICS ────────────────────────────────────── */

#RightPanel {
    background-color: #0F0F14;
    border-left: 1px solid #1C1C26;
    min-width: 260px;
    max-width: 300px;
}
#RightPanelHeader {
    font-size: 11px;
    font-weight: 600;
    color: #7A7A8E;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 16px 14px 8px;
}
#RightPanel QLabel#MetricLabel {
    color: #5A5A6E;
    font-size: 10px;
}
#RightPanel QLabel#MetricValue {
    color: #E5E5EC;
    font-size: 14px;
    font-weight: 600;
}
#RightPanel QLabel#MetricSubtitle {
    color: #5A5A6E;
    font-size: 9px;
}

/* ── PLACEHOLDER PAGES ────────────────────────────────────────── */

#PlaceholderPageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #E5E5EC;
    margin-bottom: 8px;
}
#PlaceholderPageDesc {
    font-size: 12px;
    color: #7A7A8E;
    line-height: 1.5;
}

/* ── TABS ─────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: #0D0D12;
    border: none;
    border-top: 1px solid #1C1C26;
}
QTabBar::tab {
    background-color: transparent;
    color: #7A7A8E;
    border: none;
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #A0A0B8;
}
QTabBar::tab:selected {
    color: #818cf8;
    border-bottom: 2px solid #6366f1;
}

/* ── PROGRESS BAR ─────────────────────────────────────────────── */

QProgressBar {
    background-color: #1C1C26;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #6366f1;
    border-radius: 3px;
}
QProgressBar::chunk[status="success"] {
    background-color: #22C55E;
}

/* ── TOOLTIP ──────────────────────────────────────────────────── */

QToolTip {
    background-color: #1A1A24;
    color: #E5E5EC;
    border: 1px solid #252530;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ── RELOAD BADGE ─────────────────────────────────────────────── */

#ReloadBadge {
    background-color: rgba(245, 158, 11, 0.1);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.15);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 500;
    margin: 4px 8px;
}

/* ── STAT CARD UNIFIED ────────────────────────────────────────── */

#StatCard {
    background-color: #12121C;
    border: 1px solid #1C1C2A;
    border-radius: 10px;
    padding: 12px;
}
#StatCardTitle {
    font-size: 10px;
    font-weight: 500;
    color: #7A7A8E;
    letter-spacing: 0.02em;
}
#StatCardValue {
    font-size: 22px;
    font-weight: 700;
    color: #E5E5EC;
}
#StatCardIcon {
    font-size: 18px;
}

/* MiniStatCard (MetricCard compat) */
#MiniStatCard {
    background-color: #12121C;
    border: 1px solid #1C1C2A;
    border-radius: 8px;
    padding: 8px;
}
#MiniStatCardLabel {
    font-size: 9px;
    font-weight: 500;
    color: #7A7A8E;
}
#MiniStatCardValue {
    font-size: 16px;
    font-weight: 700;
    color: #E5E5EC;
}
#MiniStatCardSubtitle {
    font-size: 9px;
    color: #5A5A6E;
}
