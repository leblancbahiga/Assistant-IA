/* ========================================================================== */
/*  ABYSSAL FLAT V7 - Thème sombre flat design                                */
/*  Palette: BG-0 #0a0b0f | BG-1 #111318 | BG-2 #1a1d26 | BG-3 #242836        */
/*  BORDER: #2e3347 | TEXT-1 #e8eaf0 | TEXT-2 #9098b0 | TEXT-3 #555e78        */
/*  ACCENT-V #7f77dd | ACCENT-T #1d9e75 | ACCENT-B #378add | ACCENT-A #ef9f27 */
/*  OK #639922 | WARN #ef9f27 | ERR #e24b4a                                    */
/* ========================================================================== */

/* ========================================================================== */
/*  GLOBAL                                                                    */
/* ========================================================================== */

QMainWindow,
QWidget {
    background-color: #0a0b0f;
    color: #e8eaf0;
    font-family: "Inter", "Segoe UI", "SF Pro Display", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QWidget:disabled {
    color: #555e78;
}

/* ========================================================================== */
/*  SPLITTER                                                                  */
/* ========================================================================== */

QSplitter::handle {
    background-color: #2e3347;
    width: 1px;
    height: 1px;
    margin: 0;
}

QSplitter::handle:pressed {
    background-color: #555e78;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ========================================================================== */
/*  SIDEBAR                                                                   */
/* ========================================================================== */

#Sidebar {
    background-color: #111318;
    border-right: 1px solid #2e3347;
    padding: 0;
    min-width: 220px;
    max-width: 280px;
}

#SidebarHeader {
    background-color: transparent;
    padding: 20px 16px 12px 16px;
    border-bottom: 1px solid #2e3347;
}

#LogoLabel {
    font-size: 22px;
    font-weight: 700;
    color: #e8eaf0;
    padding: 0;
    margin: 0;
    letter-spacing: -0.3px;
}

#VersionBadge {
    background-color: #242836;
    color: #555e78;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #2e3347;
    margin: 4px 0 0 0;
}

#NavSectionLabel {
    color: #555e78;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 16px 16px 6px 16px;
    background-color: transparent;
}

#NavButton {
    background-color: transparent;
    color: #9098b0;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    margin: 0 8px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}

#NavButton:hover {
    background-color: #242836;
    color: #e8eaf0;
}

#NavButton:pressed {
    background-color: #2e3347;
    color: #e8eaf0;
}

#NavButton:checked,
#NavButton[active="true"] {
    background-color: #1a1d26;
    color: #7f77dd;
    border-left: 2px solid #7f77dd;
    padding: 8px 16px 8px 14px;
}

/* ========================================================================== */
/*  CHAT                                                                      */
/* ========================================================================== */

#ChatZone {
    background-color: #0a0b0f;
}

#ChatHeader {
    background-color: #111318;
    border-bottom: 1px solid #2e3347;
    padding: 12px 20px;
    min-height: 40px;
}

#ChatTitleLabel {
    font-size: 16px;
    font-weight: 700;
    color: #e8eaf0;
    padding: 0;
}

/* ModeBadge - utilise une propriété dynamique "mode" */
#ModeBadge[mode="chat"] {
    background-color: #1a1d26;
    color: #378add;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid #2e3347;
}

#ModeBadge[mode="agent"] {
    background-color: #1a1d26;
    color: #7f77dd;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid #2e3347;
}

#ModeBadge[mode="code"] {
    background-color: #1a1d26;
    color: #1d9e75;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid #2e3347;
}

/* Widget de confiance */
#ConfidenceWidget {
    background-color: transparent;
    padding: 4px 0;
}

#ConfidenceBar {
    background-color: #242836;
    border: none;
    border-radius: 3px;
    height: 6px;
    min-height: 6px;
    max-height: 6px;
}

#ConfidenceBar::chunk {
    background-color: #1d9e75;
    border-radius: 3px;
}

/* ========================================================================== */
/*  MESSAGES (zone de messages)                                               */
/* ========================================================================== */

#MessagesArea {
    background-color: #0a0b0f;
    border: none;
    padding: 0;
}

/* Bulle NURU (assistant) */
#BubbleNuru {
    background-color: #111318;
    border: 1px solid #2e3347;
    border-radius: 12px;
    border-top-left-radius: 4px;
    padding: 12px 16px;
    margin: 4px 60px 4px 12px;
}

/* Bulle Utilisateur */
#BubbleUser {
    background-color: #1a1d26;
    border: 1px solid #2e3347;
    border-radius: 12px;
    border-top-right-radius: 4px;
    padding: 12px 16px;
    margin: 4px 12px 4px 60px;
}

#BubbleText {
    font-size: 13px;
    color: #e8eaf0;
    line-height: 1.5;
    background-color: transparent;
    border: none;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
}

#CitationBadge {
    background-color: #242836;
    color: #9098b0;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: 4px;
    border: 1px solid #2e3347;
    margin: 4px 0;
}

#BubbleAction {
    background-color: transparent;
    color: #555e78;
    font-size: 11px;
    font-weight: 500;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    margin: 0 2px;
}

#BubbleAction:hover {
    background-color: #242836;
    color: #9098b0;
}

/* Le label qui affiche "NURU" ou "Vous" dans chaque bulle */
QLabel[objectName^="BubbleLabel"] {
    font-size: 11px;
    font-weight: 700;
    color: #555e78;
    padding: 0;
    margin: 0 0 2px 0;
}

/* ========================================================================== */
/*  INPUT AREA                                                                */
/* ========================================================================== */

#InputArea {
    background-color: #111318;
    border-top: 1px solid #2e3347;
    padding: 12px 16px;
}

#InputFrame {
    background-color: #1a1d26;
    border: 1px solid #2e3347;
    border-radius: 10px;
    padding: 4px 8px;
}

#InputFrame:focus-within {
    border: 1px solid #378add;
}

#ChatInput {
    background-color: transparent;
    color: #e8eaf0;
    font-size: 13px;
    border: none;
    padding: 8px 8px;
    min-height: 24px;
    max-height: 120px;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
}

#ChatInput:focus {
    border: none;
}

#ChatInput::placeholder {
    color: #555e78;
}

#InputActionBtn {
    background-color: transparent;
    color: #555e78;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 16px;
    min-width: 30px;
    min-height: 30px;
}

#InputActionBtn:hover {
    background-color: #242836;
    color: #9098b0;
}

#InputActionBtn:pressed {
    background-color: #2e3347;
    color: #e8eaf0;
}

#SendBtn {
    background-color: #378add;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    min-height: 32px;
}

#SendBtn:hover {
    background-color: #2a7bcc;
}

#SendBtn:pressed {
    background-color: #1e6bb8;
}

#SendBtn:disabled {
    background-color: #242836;
    color: #555e78;
}

/* ========================================================================== */
/*  METRICS PANEL                                                             */
/* ========================================================================== */

#MetricsPanel {
    background-color: #111318;
    border-left: 1px solid #2e3347;
    padding: 0;
}

#MetricsPanelTitle {
    font-size: 14px;
    font-weight: 700;
    color: #e8eaf0;
    padding: 16px 16px 8px 16px;
    background-color: transparent;
    border-bottom: 1px solid #2e3347;
}

#StrategyBadge {
    background-color: #1a1d26;
    color: #7f77dd;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid #2e3347;
    margin: 4px 16px;
}

#MetricCard {
    background-color: #1a1d26;
    border: 1px solid #2e3347;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 6px 16px;
}

#MetricCard QLabel {
    background-color: transparent;
    color: #9098b0;
    font-size: 11px;
    font-weight: 500;
}

#MetricCard QLabel[MetricValue="true"] {
    color: #e8eaf0;
    font-size: 20px;
    font-weight: 700;
}

#MetricMiniBar {
    background-color: #2e3347;
    border: none;
    border-radius: 2px;
    height: 4px;
    min-height: 4px;
    max-height: 4px;
    margin: 4px 0;
}

#MetricMiniBar::chunk {
    background-color: #1d9e75;
    border-radius: 2px;
}

/* ========================================================================== */
/*  SECONDARY PAGES                                                           */
/* ========================================================================== */

#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #e8eaf0;
    padding: 0 0 4px 0;
    background-color: transparent;
}

#PageSubtitle {
    font-size: 13px;
    color: #9098b0;
    padding: 0 0 20px 0;
    background-color: transparent;
}

#ContentCard {
    background-color: #111318;
    border: 1px solid #2e3347;
    border-radius: 10px;
    padding: 20px;
    margin: 0 0 12px 0;
}

#DocItem {
    background-color: transparent;
    color: #9098b0;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 13px;
}

#DocItem:hover {
    background-color: #242836;
    color: #e8eaf0;
}

#DocItem:pressed {
    background-color: #2e3347;
}

#DocItem:selected {
    background-color: #1a1d26;
    color: #378add;
    border-left: 2px solid #378add;
    padding: 10px 14px 10px 12px;
}

#SettingRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #2e3347;
    padding: 12px 0;
}

#SettingRow:last {
    border-bottom: none;
}

#LogsView {
    background-color: #0a0b0f;
    color: #9098b0;
    font-family: "JetBrains Mono", "Fira Code", "SF Mono", "Menlo", monospace;
    font-size: 12px;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
}

/* ========================================================================== */
/*  QPUSHBUTTON                                                               */
/* ========================================================================== */

QPushButton {
    background-color: #1a1d26;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #242836;
    border: 1px solid #378add;
}

QPushButton:pressed {
    background-color: #2e3347;
    border: 1px solid #378add;
}

QPushButton:disabled {
    background-color: #111318;
    color: #555e78;
    border: 1px solid #242836;
}

QPushButton:checked {
    background-color: #242836;
    border: 1px solid #7f77dd;
    color: #7f77dd;
}

QPushButton#PrimaryBtn {
    background-color: #378add;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#PrimaryBtn:hover {
    background-color: #2a7bcc;
}

QPushButton#PrimaryBtn:pressed {
    background-color: #1e6bb8;
}

QPushButton#PrimaryBtn:disabled {
    background-color: #242836;
    color: #555e78;
}

QPushButton#DangerBtn {
    background-color: #e24b4a;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#DangerBtn:hover {
    background-color: #cc3f3e;
}

QPushButton#DangerBtn:pressed {
    background-color: #b53433;
}

QPushButton#DangerBtn:disabled {
    background-color: #242836;
    color: #555e78;
}

QPushButton#GhostBtn {
    background-color: transparent;
    color: #9098b0;
    border: none;
}

QPushButton#GhostBtn:hover {
    background-color: #242836;
    color: #e8eaf0;
}

QPushButton#GhostBtn:pressed {
    background-color: #2e3347;
    color: #e8eaf0;
}

/* ========================================================================== */
/*  QLINEEDIT                                                                 */
/* ========================================================================== */

QLineEdit {
    background-color: #1a1d26;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
}

QLineEdit:hover {
    border: 1px solid #555e78;
}

QLineEdit:focus {
    border: 1px solid #378add;
}

QLineEdit:disabled {
    background-color: #111318;
    color: #555e78;
    border: 1px solid #242836;
}

QLineEdit::placeholder {
    color: #555e78;
}

/* ========================================================================== */
/*  QCOMBOBOX                                                                 */
/* ========================================================================== */

QComboBox {
    background-color: #1a1d26;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 7px 30px 7px 12px;
    font-size: 13px;
    min-height: 28px;
}

QComboBox:hover {
    border: 1px solid #555e78;
}

QComboBox:focus {
    border: 1px solid #378add;
}

QComboBox:disabled {
    background-color: #111318;
    color: #555e78;
    border: 1px solid #242836;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid #2e3347;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9098b0;
    margin: 4px;
}

QComboBox QAbstractItemView {
    background-color: #1a1d26;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #242836;
}

/* ========================================================================== */
/*  QCHECKBOX                                                                 */
/* ========================================================================== */

QCheckBox {
    color: #e8eaf0;
    font-size: 13px;
    spacing: 8px;
    min-height: 20px;
}

QCheckBox:disabled {
    color: #555e78;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #2e3347;
    border-radius: 4px;
    background-color: #1a1d26;
}

QCheckBox::indicator:hover {
    border: 1px solid #378add;
}

QCheckBox::indicator:checked {
    background-color: #378add;
    border: 1px solid #378add;
}

QCheckBox::indicator:checked:hover {
    background-color: #2a7bcc;
}

QCheckBox::indicator:disabled {
    background-color: #111318;
    border: 1px solid #242836;
}

QCheckBox::indicator:checked:disabled {
    background-color: #242836;
    border: 1px solid #2e3347;
}

/* ========================================================================== */
/*  QSLIDER                                                                   */
/* ========================================================================== */

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    background-color: #242836;
    border: none;
    border-radius: 3px;
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    margin: 0;
}

QSlider::handle:horizontal {
    background-color: #378add;
    border: none;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #2a7bcc;
}

QSlider::handle:horizontal:pressed {
    background-color: #1e6bb8;
}

QSlider::sub-page:horizontal {
    background-color: #378add;
    border: none;
    border-radius: 3px;
}

QSlider::groove:vertical {
    background-color: #242836;
    border: none;
    border-radius: 3px;
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin: 0;
}

QSlider::handle:vertical {
    background-color: #378add;
    border: none;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: 0 -5px;
}

QSlider::handle:vertical:hover {
    background-color: #2a7bcc;
}

QSlider::handle:vertical:pressed {
    background-color: #1e6bb8;
}

QSlider::sub-page:vertical {
    background-color: #378add;
    border: none;
    border-radius: 3px;
}

QSlider::add-page:horizontal,
QSlider::add-page:vertical {
    background-color: #242836;
    border: none;
    border-radius: 3px;
}

/* ========================================================================== */
/*  QTOOLTIP                                                                  */
/* ========================================================================== */

QToolTip {
    background-color: #111318;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
}

/* ========================================================================== */
/*  QSCROLLBAR                                                                */
/* ========================================================================== */

QScrollBar:horizontal {
    background-color: #0a0b0f;
    border: none;
    border-radius: 0;
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    margin: 0;
    padding: 0;
}

QScrollBar::handle:horizontal {
    background-color: #2e3347;
    border: none;
    border-radius: 4px;
    min-width: 30px;
    margin: 1px 0;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555e78;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #378add;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar:vertical {
    background-color: #0a0b0f;
    border: none;
    border-radius: 0;
    width: 8px;
    min-width: 8px;
    max-width: 8px;
    margin: 0;
    padding: 0;
}

QScrollBar::handle:vertical {
    background-color: #2e3347;
    border: none;
    border-radius: 4px;
    min-height: 30px;
    margin: 0 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555e78;
}

QScrollBar::handle:vertical:pressed {
    background-color: #378add;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Scrollbar dans MessagesArea - invisible sauf au survol */
#MessagesArea QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    min-width: 6px;
    max-width: 6px;
}

#MessagesArea QScrollBar::handle:vertical {
    background-color: transparent;
    border-radius: 3px;
    min-height: 30px;
}

#MessagesArea QScrollBar::handle:vertical:hover {
    background-color: #2e3347;
}

#MessagesArea QScrollBar::handle:vertical:pressed {
    background-color: #555e78;
}

/* ========================================================================== */
/*  QTABLEWIDGET                                                              */
/* ========================================================================== */

QTableWidget {
    background-color: #0a0b0f;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 8px;
    gridline-color: #242836;
    font-size: 13px;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
    padding: 0;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #242836;
    border-right: 1px solid #242836;
}

QTableWidget::item:hover {
    background-color: #242836;
}

QTableWidget::item:selected {
    background-color: #1a1d26;
    color: #378add;
}

QHeaderView::section {
    background-color: #111318;
    color: #9098b0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #2e3347;
    border-right: 1px solid #242836;
}

QHeaderView::section:hover {
    background-color: #1a1d26;
    color: #e8eaf0;
}

/* ========================================================================== */
/*  QTABWIDGET                                                                */
/* ========================================================================== */

QTabWidget::pane {
    background-color: #0a0b0f;
    border: 1px solid #2e3347;
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 12px;
}

QTabBar::tab {
    background-color: #111318;
    color: #9098b0;
    border: 1px solid #2e3347;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    margin: 0 1px 0 0;
    min-height: 28px;
}

QTabBar::tab:hover {
    background-color: #1a1d26;
    color: #e8eaf0;
}

QTabBar::tab:selected {
    background-color: #0a0b0f;
    color: #e8eaf0;
    border-bottom: 1px solid #0a0b0f;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::close-button {
    image: none;
    background-color: transparent;
    color: #555e78;
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 3px;
    margin: 0 0 0 6px;
}

QTabBar::close-button:hover {
    background-color: #e24b4a;
}

/* ========================================================================== */
/*  QGROUPBOX                                                                 */
/* ========================================================================== */

QGroupBox {
    background-color: #111318;
    border: 1px solid #2e3347;
    border-radius: 8px;
    padding: 20px 16px 16px 16px;
    margin: 8px 0;
    font-size: 13px;
    color: #e8eaf0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 700;
    color: #9098b0;
    background-color: #1a1d26;
    border: 1px solid #2e3347;
    border-radius: 4px;
    margin: -10px 0 0 10px;
}

/* ========================================================================== */
/*  QPROGRESSBAR                                                              */
/* ========================================================================== */

QProgressBar {
    background-color: #1a1d26;
    border: 1px solid #2e3347;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: #9098b0;
    min-height: 20px;
    padding: 0;
}

QProgressBar::chunk {
    background-color: #378add;
    border-radius: 5px;
    margin: 1px;
}

QProgressBar[status="ok"]::chunk {
    background-color: #639922;
}

QProgressBar[status="warn"]::chunk {
    background-color: #ef9f27;
}

QProgressBar[status="err"]::chunk {
    background-color: #e24b4a;
}

/* ========================================================================== */
/*  QMESSAGEBOX                                                               */
/* ========================================================================== */

QMessageBox {
    background-color: #111318;
    border: 1px solid #2e3347;
    border-radius: 10px;
}

QMessageBox QLabel {
    color: #e8eaf0;
    font-size: 13px;
    padding: 8px 0;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ========================================================================== */
/*  QMENU                                                                     */
/* ========================================================================== */

QMenu {
    background-color: #111318;
    border: 1px solid #2e3347;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    color: #9098b0;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 32px 8px 14px;
    border-radius: 4px;
    min-height: 20px;
}

QMenu::item:selected {
    background-color: #242836;
    color: #e8eaf0;
}

QMenu::item:disabled {
    color: #555e78;
    background-color: transparent;
}

QMenu::separator {
    background-color: #2e3347;
    height: 1px;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin: 0 8px 0 0;
}

QMenu::right-arrow {
    image: none;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid #9098b0;
    margin: 4px;
}

/* ========================================================================== */
/*  QFRAME (utilitaires)                                                      */
/* ========================================================================== */

QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    background-color: #2e3347;
    border: none;
}

QFrame[frameShape="4"] {
    max-height: 1px;
}

QFrame[frameShape="5"] {
    max-width: 1px;
}

/* ========================================================================== */
/*  QLISTWIDGET / QLISTVIEW                                                   */
/* ========================================================================== */

QListView,
QListWidget {
    background-color: #0a0b0f;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListView::item,
QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 24px;
}

QListView::item:hover,
QListWidget::item:hover {
    background-color: #242836;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: #1a1d26;
    color: #378add;
}

/* ========================================================================== */
/*  QTEXTEDIT / QPLAINTEXTEDIT                                                */
/* ========================================================================== */

QTextEdit,
QPlainTextEdit {
    background-color: #0a0b0f;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
    selection-background-color: #242836;
    selection-color: #e8eaf0;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #378add;
}

QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #111318;
    color: #555e78;
    border: 1px solid #242836;
}

/* ========================================================================== */
/*  QSPINBOX / QDOUBLESPINBOX                                                 */
/* ========================================================================== */

QSpinBox,
QDoubleSpinBox {
    background-color: #1a1d26;
    color: #e8eaf0;
    border: 1px solid #2e3347;
    border-radius: 6px;
    padding: 7px 30px 7px 12px;
    font-size: 13px;
    min-height: 28px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border: 1px solid #555e78;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #378add;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #111318;
    color: #555e78;
    border: 1px solid #242836;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    border: none;
    border-left: 1px solid #2e3347;
    border-bottom: 1px solid #2e3347;
    border-top-right-radius: 6px;
    background-color: transparent;
    width: 28px;
    height: 14px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    border: none;
    border-left: 1px solid #2e3347;
    border-bottom-right-radius: 6px;
    background-color: transparent;
    width: 28px;
    height: 14px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #242836;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #9098b0;
    margin: 2px auto;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9098b0;
    margin: 2px auto;
}

/* ========================================================================== */
/*  QDIALOG                                                                   */
/* ========================================================================== */

QDialog {
    background-color: #111318;
    border: 1px solid #2e3347;
    border-radius: 10px;
}

QDialog QLabel {
    color: #e8eaf0;
}

/* ========================================================================== */
/*  QTOOLBAR                                                                  */
/* ========================================================================== */

QToolBar {
    background-color: #111318;
    border: none;
    border-bottom: 1px solid #2e3347;
    padding: 4px;
    spacing: 4px;
}

QToolBar::separator {
    background-color: #2e3347;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #9098b0;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #242836;
    color: #e8eaf0;
}

QToolButton:pressed {
    background-color: #2e3347;
}

QToolButton:checked {
    background-color: #1a1d26;
    color: #378add;
}

QToolButton:disabled {
    color: #555e78;
}

/* ========================================================================== */
/*  QSTATUSBAR                                                                */
/* ========================================================================== */

QStatusBar {
    background-color: #111318;
    color: #9098b0;
    border-top: 1px solid #2e3347;
    font-size: 12px;
    padding: 0 8px;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #9098b0;
    font-size: 12px;
    padding: 0 8px;
}

/* ========================================================================== */
/*  END - ABYSSAL FLAT V7                                                     */
/* ========================================================================== */
