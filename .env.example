# NURU V12 Configuration - Copy to .env and fill in your values

# LLM Providers
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model Configuration
PRIMARY_MODEL=llama-3.3-70b-groq
FALLBACK_MODEL=gpt-4-turbo
LOCAL_MODEL=phi-4-mini

# Cost Guard
DAILY_COST_BUDGET=2.0
TOKEN_BUDGET_MODE=adaptive

# Memory & Storage
MEMORY_DB_PATH=./data/memory.db
RAG_INDEX_PATH=./data/rag_index

# Voice Configuration
VOICE_ENABLED=false
WAKE_WORD=nuru
WAKE_WORD_SENSITIVITY=0.5
VAD_THRESHOLD=0.3

# Vision Configuration
VISION_ENABLED=false
VISION_PROVIDER=cloud

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/nuru.log

# Privacy & Security
PRIVACY_MODE=strict
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log
ENCRYPT_MEMORY=true

# Dashboard
DASHBOARD_PORT=8000
DASHBOARD_DEBUG=false

# Environment
ENVIRONMENT=development
